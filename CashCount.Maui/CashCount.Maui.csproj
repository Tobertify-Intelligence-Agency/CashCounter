<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>CashCount</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>Cash Counter</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.tobertify.cashcounter</ApplicationId>

        <!-- Versions: bump both values for future meaningful pushed app changes -->
        <ApplicationDisplayVersion>1.0.19</ApplicationDisplayVersion>
        <ApplicationVersion>19</ApplicationVersion>

        <WindowsPackageType>None</WindowsPackageType>
    </PropertyGroup>

    <!-- Android Release Signing -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
        <AndroidKeyStore>True</AndroidKeyStore>
        <AndroidSigningKeyStore>..\cashcount.keystore</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>cashcount</AndroidSigningKeyAlias>
        <AndroidSigningKeyPass>CashCountLemon3.</AndroidSigningKeyPass>
        <AndroidSigningStorePass>CashCountLemon3.</AndroidSigningStorePass>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2563eb" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2563eb" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Android Firebase Configuration -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <GoogleServicesJson Include="Platforms\Android\google-services.json" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="nul" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.0" />
        <!-- In-App Billing -->
        <PackageReference Include="Plugin.InAppBilling" Version="8.0.4" />
    </ItemGroup>

    <!-- Firebase packages for Android only (iOS builds happen on Mac) -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="Plugin.Firebase.Core" Version="3.1.0" />
        <PackageReference Include="Plugin.Firebase.Auth" Version="3.1.0" />
        <PackageReference Include="Plugin.Firebase.Auth.Google" Version="3.1.0" />
        <PackageReference Include="Plugin.Firebase.Firestore" Version="3.1.0" />
    </ItemGroup>

    <!-- Firebase packages for iOS (only restored on Mac) -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <PackageReference Include="Plugin.Firebase.Core" Version="3.1.0" />
        <PackageReference Include="Plugin.Firebase.Auth" Version="3.1.0" />
        <PackageReference Include="Plugin.Firebase.Firestore" Version="3.1.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CashCount.Shared\CashCount.Shared.csproj" />
    </ItemGroup>

</Project>
