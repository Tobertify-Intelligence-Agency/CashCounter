@using CashCount.Shared.Models
@using CashCount.Shared.Services
@using CashCount.Shared.Services.Auth
@using CashCount.Shared.Services.Billing
@using CashCount.Shared.Services.Localization
@inject IAuthService AuthService
@inject IPremiumService PremiumService
@inject IBillingService BillingService
@inject NavigationManager NavigationManager
@inject IAppTextService Text
@implements IDisposable

<div class="account-container account-container-minimal">
    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>@Text["account.loading"]</p>
        </div>
    }
    else if (_user == null)
    {
        <section class="not-signed-in not-signed-in-minimal">
            <div class="account-icon">👤</div>
            <h2>@Text["account.signedOut.title"]</h2>
            <p>@Text["account.signedOut.body"]</p>
            <div class="auth-buttons">
                <a href="/login" class="btn-primary">@Text["account.signIn"]</a>
                <a href="/register" class="btn-secondary">@Text["account.create"]</a>
            </div>
        </section>
    }
    else
    {
        <section class="account-card account-card-minimal">
            <div class="account-header account-header-minimal">
                <div class="account-header-main">
                    @if (!string.IsNullOrEmpty(_user.PhotoUrl))
                    {
                        <img src="@_user.PhotoUrl" alt="Profile" class="profile-photo" />
                    }
                    else
                    {
                        <div class="profile-placeholder">
                            @(_user.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </div>
                    }
                    <div class="account-info">
                        <p class="af-eyebrow">@Text["account.profile"]</p>
                        <h2>@_user.DisplayName</h2>
                        <p class="account-email">@_user.Email</p>
                        @if (!string.IsNullOrEmpty(_user.AuthProvider))
                        {
                            <span class="auth-provider-badge">@GetProviderName(_user.AuthProvider)</span>
                        }
                    </div>
                </div>
                <button class="btn-signout btn-signout-inline" @onclick="SignOutAsync">@Text["account.signOut"]</button>
            </div>

            <div class="premium-section premium-section-minimal">
                <div class="af-panel-header af-panel-header-minimalized">
                    <div>
                        <h3>@Text["account.premiumStatus"]</h3>
                        <p>@Text["account.upgradeTitle"]</p>
                    </div>
                </div>

                @if (_isPremium)
                {
                    <div class="premium-active premium-active-minimal">
                        <div class="premium-badge-large">@Text["account.premiumActive"]</div>
                        @if (_user.PremiumExpiryDate.HasValue)
                        {
                            <p class="expiry-date">@Text.Format("account.validUntil", _user.PremiumExpiryDate.Value.ToString("D", Text.CurrentCulture))</p>
                        }
                        <ul class="premium-features-list">
                            <li>@Text["account.premium.feature.currency"]</li>
                            <li>@Text["account.premium.feature.save"]</li>
                            <li>@Text["account.premium.feature.sync"]</li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="premium-upgrade premium-upgrade-minimal">
                        <h4>@Text["account.upgradeTitle"]</h4>
                        <ul class="premium-features-list">
                            <li>@Text["account.premium.feature.currency"]</li>
                            <li>@Text["account.premium.feature.save"]</li>
                            <li>@Text["account.premium.feature.sync"]</li>
                        </ul>

                        @if (_purchaseError != null)
                        {
                            <div class="error-message">@_purchaseError</div>
                        }

                        @if (_billingAvailable && _products.Any())
                        {
                            <div class="purchase-options">
                                @foreach (var product in _products)
                                {
                                    <button class="btn-upgrade"
                                            @onclick="() => PurchaseAsync(product.ProductId)"
                                            disabled="@_isPurchasing">
                                        @if (_isPurchasing)
                                        {
                                            <span>@Text["account.processing"]</span>
                                        }
                                        else
                                        {
                                            <span>@Text.Format("account.upgradeFor", product.FormattedPrice)</span>
                                        }
                                    </button>
                                }
                                <button class="btn-restore" @onclick="RestorePurchasesAsync" disabled="@_isPurchasing">
                                    @Text["account.restore"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="purchase-unavailable">
                                <p>@Text["account.purchaseUnavailable.title"]</p>
                                <p>@Text["account.purchaseUnavailable.body"]</p>
                                <div class="store-links">
                                    <a href="https://apps.apple.com" class="store-badge appstore" target="_blank">App Store</a>
                                    <a href="https://play.google.com" class="store-badge playstore" target="_blank">Google Play</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <section class="account-section-card">

        <CashCount.Shared.Components.AccountLedgerManager />
    </section>
</div>

@code {
    private UserProfile? _user;
    private bool _isPremium = false;
    private bool _billingAvailable = false;
    private List<ProductInfo> _products = new();
    private bool _isLoading = true;
    private bool _isPurchasing = false;
    private string? _purchaseError;

    protected override async Task OnInitializedAsync()
    {
        Text.Changed += OnTextChanged;
        await LoadAccountDataAsync();
        BillingService.PurchaseCompleted += OnPurchaseCompleted;
    }

    private void OnTextChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAccountDataAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _user = await AuthService.GetCurrentUserAsync();
            _isPremium = await PremiumService.IsPremiumAsync();
            _billingAvailable = await BillingService.IsAvailableAsync();

            if (_billingAvailable && !_isPremium)
                _products = await BillingService.GetProductsAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"LoadAccountData error: {ex.Message}");
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task PurchaseAsync(string productId)
    {
        _isPurchasing = true;
        _purchaseError = null;
        StateHasChanged();

        var result = await BillingService.PurchaseAsync(productId);
        _isPurchasing = false;

        if (result.Success)
        {
            await PremiumService.SetPremiumStatusAsync(true);
            _isPremium = true;
        }
        else if (result.State != PurchaseState.Cancelled)
        {
            _purchaseError = result.ErrorMessage;
        }

        StateHasChanged();
    }

    private async Task RestorePurchasesAsync()
    {
        _isPurchasing = true;
        _purchaseError = null;
        StateHasChanged();

        var restored = await BillingService.RestorePurchasesAsync();
        _isPurchasing = false;

        if (restored)
        {
            await PremiumService.SetPremiumStatusAsync(true);
            _isPremium = true;
        }
        else
        {
            _purchaseError = Text["account.noPurchases"];
        }

        StateHasChanged();
    }

    private async void OnPurchaseCompleted(object? sender, PurchaseResult result)
    {
        if (result.Success || result.State == PurchaseState.Restored)
        {
            await PremiumService.SetPremiumStatusAsync(true);
            _isPremium = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SignOutAsync()
    {
        await AuthService.SignOutAsync();
        _user = null;
        NavigationManager.NavigateTo("/");
    }

    private string GetProviderName(string provider)
    {
        return provider.ToLowerInvariant() switch
        {
            "google.com" => Text["account.provider.google"],
            "apple.com" => Text["account.provider.apple"],
            "microsoft.com" => Text["account.provider.microsoft"],
            "password" or "email" => Text["account.provider.email"],
            _ => provider
        };
    }

    public void Dispose()
    {
        Text.Changed -= OnTextChanged;
        BillingService.PurchaseCompleted -= OnPurchaseCompleted;
    }
}
