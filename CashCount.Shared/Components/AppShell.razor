@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@inject IAppTextService Text
@implements IDisposable

<div class="app-shell @(IsMenuOpen ? "menu-open" : "")">
    <aside class="side-menu">
        <div class="menu-header">
            <h2>@Text["app.tools"]</h2>
            <button class="menu-close" @onclick="ToggleMenu" aria-label="Close">✕</button>
        </div>
        <nav class="menu-nav">
            @foreach (var tool in Tools)
            {
                <a href="@tool.Href"
                   class="menu-item @(IsCurrentTool(tool) ? "active" : "")"
                   @onclick="CloseMenu">
                    <span class="menu-icon">@tool.Icon</span>
                    <span class="menu-label">@Text[tool.LabelKey]</span>
                </a>
            }
        </nav>
        <div class="menu-footer">
            <div class="app-language-switcher app-language-switcher-menu">
                <label for="menu-language">@Text["app.language"]</label>
                <select id="menu-language" class="app-language-select" value="@Text.CurrentLanguage.Code" @onchange="OnLanguageChanged">
                    @foreach (var language in Text.Languages)
                    {
                        <option value="@language.Code">@language.NativeName</option>
                    }
                </select>
            </div>
            <span class="app-version">@Text["app.version"]</span>
        </div>
    </aside>

    <div class="menu-overlay" @onclick="ToggleMenu"></div>

    <main class="main-content">
        <header class="top-bar">
            <button class="menu-toggle" @onclick="ToggleMenu" aria-label="Toggle menu">
                <span class="hamburger-icon">&#9776;</span>
            </button>
            <h1 class="current-tool-name">@GetCurrentToolName()</h1>
        </header>
        <div class="content-area">
            @ChildContent
        </div>
    </main>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string CurrentTool { get; set; } = string.Empty;

    private bool IsMenuOpen { get; set; }
    private string CurrentPath { get; set; } = "/";

    private List<ToolItem> Tools { get; } = new()
    {
        new ToolItem { Id = "cash-counter", LabelKey = "tool.cashCounter", Icon = "💰", Href = "/" },
        new ToolItem { Id = "saved-counts", LabelKey = "tool.savedCounts", Icon = "💾", Href = "/saved" },
        new ToolItem { Id = "travel-cost", LabelKey = "tool.travelCost", Icon = "✈️", Href = "/travel-cost" },
        new ToolItem { Id = "saved-trips", LabelKey = "tool.savedTrips", Icon = "🗺️", Href = "/saved-trips" },
        new ToolItem { Id = "funds", LabelKey = "tool.funds", Icon = "🏦", Href = "/funds" },
        new ToolItem { Id = "account", LabelKey = "tool.account", Icon = "👤", Href = "/account" }
    };

    protected override void OnInitialized()
    {
        UpdateCurrentPath();
        NavigationManager.LocationChanged += OnLocationChanged;
        Text.Changed += OnTextChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Text.InitializeAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPath();
        IsMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnTextChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPath()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        CurrentPath = "/" + relativePath.Split('?', '#')[0].Trim('/');
        if (CurrentPath == "//" || string.IsNullOrWhiteSpace(CurrentPath))
            CurrentPath = "/";
        if (CurrentPath != "/")
            CurrentPath = CurrentPath.TrimEnd('/');
    }

    private bool IsCurrentTool(ToolItem tool)
    {
        if (tool.Href == "/")
            return CurrentPath == "/";

        return CurrentPath.Equals(tool.Href, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnLanguageChanged(ChangeEventArgs args)
    {
        var code = args.Value?.ToString() ?? "en";
        await Text.SetLanguageAsync(code);
    }

    private void ToggleMenu()
    {
        IsMenuOpen = !IsMenuOpen;
    }

    private void CloseMenu()
    {
        IsMenuOpen = false;
    }

    private string GetCurrentToolName()
    {
        return Tools.FirstOrDefault(IsCurrentTool) is { } tool ? Text[tool.LabelKey] : Text["app.tools"];
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        Text.Changed -= OnTextChanged;
    }

    private class ToolItem
    {
        public string Id { get; set; } = string.Empty;
        public string LabelKey { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string Href { get; set; } = "/";
    }
}
