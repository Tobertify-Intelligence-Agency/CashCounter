@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="app-shell @(IsMenuOpen ? "menu-open" : "")">
    <aside class="side-menu">
        <div class="menu-header">
            <h2>Tools</h2>
            <button class="menu-close" @onclick="ToggleMenu">X</button>
        </div>
        <nav class="menu-nav">
            @foreach (var tool in Tools)
            {
                <a href="@tool.Href"
                   class="menu-item @(IsCurrentTool(tool) ? "active" : "")"
                   @onclick="CloseMenu">
                    <span class="menu-icon">@tool.Icon</span>
                    <span class="menu-label">@tool.Name</span>
                </a>
            }
        </nav>
        <div class="menu-footer">
            <span class="app-version">v1.1</span>
        </div>
    </aside>

    <div class="menu-overlay" @onclick="ToggleMenu"></div>

    <main class="main-content">
        <header class="top-bar">
            <button class="menu-toggle" @onclick="ToggleMenu" aria-label="Toggle menu">
                <span class="hamburger-icon">&#9776;</span>
            </button>
            <h1 class="current-tool-name">@GetCurrentToolName()</h1>
        </header>
        <div class="content-area">
            @ChildContent
        </div>
    </main>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string CurrentTool { get; set; } = string.Empty;

    private bool IsMenuOpen { get; set; }
    private string CurrentPath { get; set; } = "/";

    private List<ToolItem> Tools { get; } = new()
    {
        new ToolItem { Id = "cash-counter", Name = "Cash Counter", Icon = "💰", Href = "/" },
        new ToolItem { Id = "saved-counts", Name = "Saved Counts", Icon = "💾", Href = "/saved" },
        new ToolItem { Id = "travel-cost", Name = "Travel Cost", Icon = "✈️", Href = "/travel-cost" },
        new ToolItem { Id = "saved-trips", Name = "Saved Trips", Icon = "🗺️", Href = "/saved-trips" },
        new ToolItem { Id = "funds", Name = "Funds", Icon = "🏦", Href = "/funds" },
        new ToolItem { Id = "account", Name = "Account", Icon = "👤", Href = "/account" }
    };

    protected override void OnInitialized()
    {
        UpdateCurrentPath();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPath();
        IsMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPath()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        CurrentPath = "/" + relativePath.Split('?', '#')[0].Trim('/');
        if (CurrentPath == "//" || string.IsNullOrWhiteSpace(CurrentPath))
            CurrentPath = "/";
        if (CurrentPath != "/")
            CurrentPath = CurrentPath.TrimEnd('/');
    }

    private bool IsCurrentTool(ToolItem tool)
    {
        if (tool.Href == "/")
            return CurrentPath == "/";

        return CurrentPath.Equals(tool.Href, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleMenu()
    {
        IsMenuOpen = !IsMenuOpen;
    }

    private void CloseMenu()
    {
        IsMenuOpen = false;
    }

    private string GetCurrentToolName()
    {
        return Tools.FirstOrDefault(IsCurrentTool)?.Name ?? "Tools";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private class ToolItem
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string Href { get; set; } = "/";
    }
}
