@using System.Text.Json
@using CashCount.Shared.Models
@using CashCount.Shared.Services
@inject IStorageService StorageService
@inject IPremiumService PremiumService
@inject NavigationManager NavigationManager
@inject SavedCountExportService SavedCountExportService
@inject SavedCountReceiptService SavedCountReceiptService
@inject IJSRuntime JSRuntime
@inject IAppTextService Text

<div class="saved-counts">
    @if (!_isPremium)
    {
        <div class="premium-required">
            <div class="premium-icon">🔒</div>
            <h3>@Text["savedCounts.premium.title"]</h3>
            <p>@Text["savedCounts.premium.body1"]</p>
            <p>@Text["savedCounts.premium.body2"]</p>
            <a href="/" class="btn-primary">@Text["savedCounts.backToCounter"]</a>
        </div>
    }
    else if (_isLoading)
    {
        <div class="loading">@Text["savedCounts.loading"]</div>
    }
    else if (_savedCounts.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">📋</div>
            <h3>@Text["savedCounts.empty.title"]</h3>
            <p>@Text["savedCounts.empty.body"]</p>
            <a href="/" class="btn-primary">@Text["savedCounts.startCounting"]</a>
        </div>
    }
    else
    {
        <div class="saved-counts-header">
            <span class="count-badge">@_savedCounts.Count @Text["app.saved"]</span>
            <button class="btn-clear-all" @onclick="ConfirmClearAll">@Text["app.clearAll"]</button>
        </div>

        @if (_showConfirmClear)
        {
            <div class="confirm-dialog">
                <p>@Text["savedCounts.confirmClear"]</p>
                <div class="confirm-buttons">
                    <button class="btn-cancel" @onclick="() => _showConfirmClear = false">@Text["app.cancel"]</button>
                    <button class="btn-delete" @onclick="ClearAllCounts">@Text["savedCounts.deleteAll"]</button>
                </div>
            </div>
        }

        <div class="saved-counts-list">
            @foreach (var saved in _savedCounts)
            {
                <div class="saved-count-card sc-compact">

                    <div class="sc-main-row">
                        <div class="sc-info">
                            <span class="sc-name">@saved.Name</span>
                            <div class="sc-meta">
                                <span class="sc-date">@saved.SavedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                @if (saved.Signature?.HasAnySignature == true)
                                {
                                    <span class="sc-pill sc-pill-signed">@Text["savedCounts.signed"]</span>
                                }
                                @if (saved.LedgerTransactionId != null)
                                {
                                    <span class="sc-pill sc-pill-booked">@Text["savedCounts.booked"]</span>
                                }
                            </div>
                        </div>
                        <div class="sc-right">
                            <span class="sc-amount">@saved.CurrencySymbol @saved.TotalAmount.ToString("N2")</span>
                            <button class="btn-kebab @(_menuOpenId == saved.Id ? "active" : null)"
                                    @onclick="() => ToggleCardMenu(saved.Id)"
                                    aria-label="@Text["savedCounts.actions"]">⋮</button>
                        </div>
                    </div>

                    @if (saved.Denominations.Any())
                    {
                        <details class="denomination-details sc-denom-details">
                            <summary>@saved.Denominations.Count @Text["cashCounter.items"]</summary>
                            <div class="denomination-list">
                                @foreach (var denom in saved.Denominations)
                                {
                                    <span class="denom-item @(denom.IsCoin ? "coin" : "banknote")">
                                        @denom.Quantity × @denom.DisplayName
                                    </span>
                                }
                            </div>
                        </details>
                    }

                    @if (_menuOpenId == saved.Id)
                    {
                        <div class="sc-action-menu">
                            <button class="sc-menu-item" @onclick="() => MenuLoad(saved)">
                                <span>📥</span> @Text["savedCounts.load"]
                            </button>
                            <button class="sc-menu-item" @onclick="() => MenuSign(saved)">
                                <span>✏️</span> @Text["savedCounts.sign"]
                            </button>
                            @if (saved.LedgerTransactionId == null)
                            {
                                <button class="sc-menu-item" @onclick="() => MenuBook(saved)">
                                    <span>📒</span> @Text["savedCounts.book"]
                                </button>
                            }
                            <button class="sc-menu-item" @onclick="() => MenuExportPdf(saved)">
                                <span>📄</span> @Text["savedCounts.exportPdf"]
                            </button>
                            <button class="sc-menu-item" @onclick="() => MenuExportReceipt(saved)">
                                <span>🧾</span> @Text["savedCounts.exportReceipt"]
                            </button>
                            <div class="sc-menu-divider"></div>
                            <button class="sc-menu-item sc-menu-item-danger" @onclick="() => MenuDelete(saved.Id)">
                                <span>🗑️</span> @Text["app.delete"]
                            </button>
                        </div>
                    }

                </div>
            }
        </div>
    }

    <!-- ── Sign modal ── -->
    @if (_panelType == "sign" && _panelCount != null)
    {
        <div class="sc-modal-backdrop" @onclick="ClosePanel">
            <div class="sc-modal" @onclick:stopPropagation>
                <div class="sc-modal-header">
                    <div>
                        <h3>@Text.Format("savedCounts.signTitle", _panelCount.Name)</h3>
                        <p>@Text["savedCounts.signBody"]</p>
                    </div>
                    <button class="sc-modal-close" @onclick="ClosePanel" aria-label="@Text["savedCounts.close"]">✕</button>
                </div>

                <div class="sc-modal-body">
                    @if (_signatureSaveState == SignatureSaveState.Saved)
                    {
                        <div class="saved-signature-feedback success" style="margin-bottom:0.75rem">@Text["savedCounts.signatureSaved"]</div>
                    }
                    else if (_signatureSaveState == SignatureSaveState.Error)
                    {
                        <div class="saved-signature-feedback error" style="margin-bottom:0.75rem">@Text["savedCounts.signatureError"]</div>
                    }

                    <!-- Signer tabs -->
                    <div class="sig-tabs">
                        <button class="sig-tab @(_activeSignerTab == 1 ? "active" : null)"
                                @onclick="() => SetSignerTab(1)">
                            @Text["savedCounts.signer1"]
                            @if (!string.IsNullOrWhiteSpace(_signerName))
                            {
                                <span class="sig-tab-dot"></span>
                            }
                        </button>
                        <button class="sig-tab @(_activeSignerTab == 2 ? "active" : null)"
                                @onclick="() => SetSignerTab(2)">
                            @Text["savedCounts.signer2"]
                            @if (!string.IsNullOrWhiteSpace(_signerName2))
                            {
                                <span class="sig-tab-dot"></span>
                            }
                        </button>
                    </div>

                    <!-- @Text["savedCounts.signer1"] panel -->
                    @if (_activeSignerTab == 1)
                    {
                        <div class="sig-tab-panel">
                            <div class="saved-signature-form-grid">
                                <div class="saved-signature-field">
                                    <label for="signature-name">@Text["savedCounts.signerName"]</label>
                                    <input id="signature-name" class="saved-signature-input" @bind="_signerName" @bind:event="oninput" placeholder="@Text["savedCounts.signerNamePlaceholder"]" />
                                </div>
                            </div>
                            <div class="saved-signature-canvas-wrap @(null)">
                                <div class="saved-signature-canvas-header">
                                    <span>@Text["savedCounts.drawSignature"]</span>
                                    <button class="btn-link-action" @onclick="() => ClearDrawnSignatureAsync(false)" disabled="@(false)" >@Text["savedCounts.clearSignature"]</button>
                                </div>
                                <canvas id="@_signatureCanvasId" class="saved-signature-canvas"></canvas>
                            </div>
                        </div>
                    }

                    <!-- @Text["savedCounts.signer2"] panel -->
                    @if (_activeSignerTab == 2)
                    {
                        <div class="sig-tab-panel">
                            <div class="saved-signature-form-grid">
                                <div class="saved-signature-field">
                                    <label for="signature-name-2">@Text["savedCounts.signerName"]</label>
                                    <input id="signature-name-2" class="saved-signature-input" @bind="_signerName2" @bind:event="oninput" placeholder="@Text["savedCounts.signerName2Placeholder"]" />
                                </div>
                            </div>
                            <div class="saved-signature-canvas-wrap @(null)">
                                <div class="saved-signature-canvas-header">
                                    <span>@Text["savedCounts.drawSignature"]</span>
                                    <button class="btn-link-action" @onclick="() => ClearDrawnSignatureAsync(true)" disabled="@(false)" >@Text["savedCounts.clearSignature"]</button>
                                </div>
                                <canvas id="@_signatureCanvasId2" class="saved-signature-canvas"></canvas>
                            </div>
                        </div>
                    }
                </div>

                <div class="sc-modal-footer">
                    <button class="btn-cancel" @onclick="ClosePanel">@Text["app.cancel"]</button>
                    <button class="btn-secondary-action" @onclick="() => RemoveSignatureAsync(_panelCount)"
                            disabled="@(!(_panelCount.Signature?.HasAnySignature ?? false) && !HasWorkingSignature())">
                        @Text["savedCounts.removeSignature"]
                    </button>
                    <button class="btn-load" @onclick="() => SaveSignatureAsync(_panelCount)">@Text["savedCounts.saveSignature"]</button>
                </div>
            </div>
        </div>
    }

    <!-- ── Book modal ── -->
    @if (_panelType == "book" && _panelCount != null)
    {
        <div class="sc-modal-backdrop" @onclick="ClosePanel">
            <div class="sc-modal sc-modal-sm" @onclick:stopPropagation>
                <div class="sc-modal-header">
                    <div>
                        <h3>@Text["savedCounts.bookTitle"]</h3>
                        <p>@_panelCount.CurrencySymbol @_panelCount.TotalAmount.ToString("N2") will be added as a transaction.</p>
                    </div>
                    <button class="sc-modal-close" @onclick="ClosePanel" aria-label="@Text["savedCounts.close"]">✕</button>
                </div>

                <div class="sc-modal-body">
                    @if (_ledger.Accounts.Count == 0)
                    {
                        <p class="booking-no-accounts">@Text["savedCounts.noAccounts"]</p>
                    }
                    else
                    {
                        <div class="booking-direction-toggle">
                            <button class="booking-direction-btn @(_bookingDirection == CashFlowDirection.Incoming ? "active" : null)"
                                    @onclick="() => _bookingDirection = CashFlowDirection.Incoming" >↑ @Text["funds.modal.incoming"]</button>
                            <button class="booking-direction-btn @(_bookingDirection == CashFlowDirection.Outgoing ? "active" : null)"
                                    @onclick="() => _bookingDirection = CashFlowDirection.Outgoing" >↓ @Text["funds.modal.outgoing"]</button>
                        </div>
                        <div class="booking-form">
                            <div class="saved-signature-field">
                                <label>@Text["savedCounts.account"]</label>
                                <select class="saved-signature-input" @bind="_bookingAccountId">
                                    <option value="">— @Text["savedCounts.selectAccount"] —</option>
                                    @foreach (var acc in _ledger.Accounts)
                                    {
                                        <option value="@acc.Id">@acc.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="saved-signature-field">
                                <label>@Text["travel.field.description"]</label>
                                <input class="saved-signature-input" @bind="_bookingDescription" @bind:event="oninput" placeholder="@Text["savedCounts.transactionDescriptionPlaceholder"]" />
                            </div>
                        </div>
                        @if (_bookingError)
                        {
                            <span class="saved-signature-feedback error">@Text["savedCounts.selectAccountError"]</span>
                        }
                    }
                </div>

                <div class="sc-modal-footer">
                    <button class="btn-cancel" @onclick="ClosePanel">@Text["app.cancel"]</button>
                    @if (_ledger.Accounts.Count > 0)
                    {
                        <button class="btn-load" @onclick="() => ConfirmBookingAsync(_panelCount)"
                                disabled="@(string.IsNullOrEmpty(_bookingAccountId))">
                            @Text["savedCounts.confirmBooking"]
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly JsonSerializerOptions _jsonOptions = new(JsonSerializerDefaults.Web);
    private readonly string _signatureCanvasId = "saved-count-signature-pad";
    private readonly string _signatureCanvasId2 = "saved-count-signature-pad-2";

    private List<SavedCount> _savedCounts = new();
    private bool _isLoading = true;
    private bool _showConfirmClear = false;
    private bool _isPremium = false;

    private string? _menuOpenId;

    private string? _panelType;
    private SavedCount? _panelCount;
    private string? _initializedCanvasKey;

    private int _activeSignerTab = 1;

    private string _signerName = string.Empty;
    private List<SignatureStroke> _drawnStrokes = new();
    private string _signerName2 = string.Empty;
    private List<SignatureStroke> _drawnStrokes2 = new();

    private SignatureSaveState _signatureSaveState = SignatureSaveState.None;

    private AccountLedger _ledger = new();
    private CashFlowDirection _bookingDirection = CashFlowDirection.Incoming;
    private string _bookingAccountId = string.Empty;
    private string _bookingDescription = string.Empty;
    private bool _bookingError = false;

    protected override async Task OnInitializedAsync()
    {
        _isPremium = await PremiumService.IsFeatureEnabledAsync(PremiumFeature.LoadCounts);
        _ledger = await StorageService.GetAccountLedgerAsync();
        if (_isPremium)
            await LoadSavedCounts();
        else
            _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_panelType == "sign" && _panelCount != null)
        {
            var canvasKey = $"{_panelCount.Id}:{_activeSignerTab}";
            if (canvasKey != _initializedCanvasKey)
            {
                _initializedCanvasKey = canvasKey;
                if (_activeSignerTab == 1)
                    await JSRuntime.InvokeVoidAsync("cashCountSignature.init", _signatureCanvasId, JsonSerializer.Serialize(_drawnStrokes, _jsonOptions));
                else
                    await JSRuntime.InvokeVoidAsync("cashCountSignature.init", _signatureCanvasId2, JsonSerializer.Serialize(_drawnStrokes2, _jsonOptions));
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadSavedCounts()
    {
        _isLoading = true;
        _savedCounts = await StorageService.GetSavedCountsAsync();
        _savedCounts = _savedCounts.OrderByDescending(c => c.SavedAt).ToList();
        _isLoading = false;
    }

    private void ToggleCardMenu(string id)
    {
        _menuOpenId = _menuOpenId == id ? null : id;
    }

    private void MenuLoad(SavedCount saved)
    {
        _menuOpenId = null;
        NavigationManager.NavigateTo($"/?load={saved.Id}");
    }

    private void MenuSign(SavedCount saved)
    {
        _menuOpenId = null;
        _panelType = "sign";
        _panelCount = saved;
        _signerName = saved.Signature?.SignerName ?? string.Empty;
        _drawnStrokes = saved.Signature?.DrawnStrokes?.Select(CloneStroke).ToList() ?? new();
        _signerName2 = saved.SecondSignature?.SignerName ?? string.Empty;
        _drawnStrokes2 = saved.SecondSignature?.DrawnStrokes?.Select(CloneStroke).ToList() ?? new();
        _signatureSaveState = SignatureSaveState.None;
        _activeSignerTab = 1;
        _initializedCanvasKey = null;
    }

    private void MenuBook(SavedCount saved)
    {
        _menuOpenId = null;
        _panelType = "book";
        _panelCount = saved;
        _bookingDirection = CashFlowDirection.Incoming;
        _bookingAccountId = string.Empty;
        _bookingDescription = saved.Name;
        _bookingError = false;
    }

    private async Task MenuExportPdf(SavedCount saved)
    {
        _menuOpenId = null;
        await CollectInProgressSignatureAsync(saved);
        await SavedCountExportService.ExportAsync(saved);
    }

    private async Task MenuExportReceipt(SavedCount saved)
    {
        _menuOpenId = null;
        await CollectInProgressSignatureAsync(saved);
        await SavedCountReceiptService.ExportAsync(saved);
    }

    private async Task MenuDelete(string id)
    {
        _menuOpenId = null;
        await StorageService.DeleteCountAsync(id);
        if (_panelCount?.Id == id)
            ClosePanel();
        await LoadSavedCounts();
    }

    private void ClosePanel()
    {
        _panelType = null;
        _panelCount = null;
        _initializedCanvasKey = null;
        _signerName = string.Empty;
        _drawnStrokes = new();
        _signerName2 = string.Empty;
        _drawnStrokes2 = new();
        _signatureSaveState = SignatureSaveState.None;
        _activeSignerTab = 1;
    }

    private async Task SetSignerTab(int tab)
    {
        if (_activeSignerTab == 1)
            _drawnStrokes = await GetCurrentDrawnSignatureAsync(second: false);
        else if (_activeSignerTab == 2)
            _drawnStrokes2 = await GetCurrentDrawnSignatureAsync(second: true);

        _activeSignerTab = tab;
        _initializedCanvasKey = null;
    }

    private async Task SaveSignatureAsync(SavedCount saved)
    {
        _signatureSaveState = SignatureSaveState.None;
        _drawnStrokes = await GetCurrentDrawnSignatureAsync();
        _drawnStrokes2 = await GetCurrentDrawnSignatureAsync(second: true);

        var hasDrawn = _drawnStrokes.Any(s => s.Points.Count > 0);
        if (string.IsNullOrWhiteSpace(_signerName) || !hasDrawn)
        {
            _signatureSaveState = SignatureSaveState.Error;
            return;
        }

        saved.Signature = new SavedCountSignature
        {
            SignerName = _signerName.Trim(),
            SignedAt = DateTime.UtcNow,
            DrawnStrokes = _drawnStrokes.Select(CloneStroke).ToList()
        };

        var has2Drawn = _drawnStrokes2.Any(s => s.Points.Count > 0);
        if (!string.IsNullOrWhiteSpace(_signerName2) || has2Drawn)
        {
            saved.SecondSignature = new SavedCountSignature
            {
                SignerName = _signerName2.Trim(),
                SignedAt = DateTime.UtcNow,
                DrawnStrokes = _drawnStrokes2.Select(CloneStroke).ToList()
            };
        }

        await StorageService.SaveCountAsync(saved);
        _signatureSaveState = SignatureSaveState.Saved;
        await LoadSavedCounts();
    }

    private async Task RemoveSignatureAsync(SavedCount saved)
    {
        saved.Signature = new SavedCountSignature();
        saved.SecondSignature = new SavedCountSignature();
        await StorageService.SaveCountAsync(saved);
        await JSRuntime.InvokeVoidAsync("cashCountSignature.clear", _signatureCanvasId);
        await JSRuntime.InvokeVoidAsync("cashCountSignature.clear", _signatureCanvasId2);
        ClosePanel();
        await LoadSavedCounts();
    }

    private async Task ClearDrawnSignatureAsync(bool second = false)
    {
        if (second)
        {
            _drawnStrokes2.Clear();
            await JSRuntime.InvokeVoidAsync("cashCountSignature.clear", _signatureCanvasId2);
        }
        else
        {
            _drawnStrokes.Clear();
            await JSRuntime.InvokeVoidAsync("cashCountSignature.clear", _signatureCanvasId);
        }
        _signatureSaveState = SignatureSaveState.None;
    }

    private async Task<List<SignatureStroke>> GetCurrentDrawnSignatureAsync(bool second = false)
    {
        var canvasId = second ? _signatureCanvasId2 : _signatureCanvasId;
        var json = await JSRuntime.InvokeAsync<string>("cashCountSignature.getStrokes", canvasId);
        if (string.IsNullOrWhiteSpace(json))
            return new List<SignatureStroke>();
        return JsonSerializer.Deserialize<List<SignatureStroke>>(json, _jsonOptions) ?? new List<SignatureStroke>();
    }

    private bool HasWorkingSignature()
        => !string.IsNullOrWhiteSpace(_signerName)
           || _drawnStrokes.Any(s => s.Points.Count > 0)
           || !string.IsNullOrWhiteSpace(_signerName2)
           || _drawnStrokes2.Any(s => s.Points.Count > 0);

    private async Task ConfirmBookingAsync(SavedCount saved)
    {
        if (string.IsNullOrEmpty(_bookingAccountId))
        {
            _bookingError = true;
            return;
        }

        var transaction = new AccountTransaction
        {
            AccountId = _bookingAccountId,
            Description = string.IsNullOrWhiteSpace(_bookingDescription) ? saved.Name : _bookingDescription.Trim(),
            Amount = saved.TotalAmount,
            Direction = _bookingDirection,
            Date = saved.SavedAt.ToLocalTime().Date,
            Category = "Cash Count"
        };

        _ledger.Transactions.Add(transaction);
        await StorageService.SaveAccountLedgerAsync(_ledger);
        saved.LedgerTransactionId = transaction.Id;
        await StorageService.SaveCountAsync(saved);

        ClosePanel();
        await LoadSavedCounts();
    }

    private async Task CollectInProgressSignatureAsync(SavedCount saved)
    {
        if (_panelType != "sign" || _panelCount?.Id != saved.Id) return;

        _drawnStrokes = await GetCurrentDrawnSignatureAsync();
        _drawnStrokes2 = await GetCurrentDrawnSignatureAsync(second: true);

        if (_drawnStrokes.Any(s => s.Points.Count > 0) || !string.IsNullOrWhiteSpace(_signerName))
        {
            saved.Signature = new SavedCountSignature
            {
                SignerName = _signerName.Trim(),
                SignedAt = saved.Signature?.SignedAt ?? DateTime.UtcNow,
                DrawnStrokes = _drawnStrokes.Select(CloneStroke).ToList()
            };
        }

        if (_drawnStrokes2.Any(s => s.Points.Count > 0) || !string.IsNullOrWhiteSpace(_signerName2))
        {
            saved.SecondSignature = new SavedCountSignature
            {
                SignerName = _signerName2.Trim(),
                SignedAt = saved.SecondSignature?.SignedAt ?? DateTime.UtcNow,
                DrawnStrokes = _drawnStrokes2.Select(CloneStroke).ToList()
            };
        }

        await StorageService.SaveCountAsync(saved);
        await LoadSavedCounts();
    }

    private void ConfirmClearAll() => _showConfirmClear = true;

    private async Task ClearAllCounts()
    {
        await StorageService.ClearAllAsync();
        _showConfirmClear = false;
        ClosePanel();
        await LoadSavedCounts();
    }

    private static SignatureStroke CloneStroke(SignatureStroke stroke)
        => new() { Points = stroke.Points.Select(p => new SignaturePoint { X = p.X, Y = p.Y }).ToList() };

    private enum SignatureSaveState { None, Saved, Error }
}
