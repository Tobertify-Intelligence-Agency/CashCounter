@using CashCount.Shared.Models
@using CashCount.Shared.Services
@using CashCount.Shared.Services.Localization
@inject IStorageService StorageService
@inject IPremiumService PremiumService
@inject NavigationManager NavigationManager
@inject IAppTextService Text
@implements IDisposable

<div class="cash-counter cash-counter-compact">


    @if (_canSaveCounts || _canSelectCurrency)
    {
        <section class="cc-toolbar-card" style="margin-bottom: 1rem">
            @if (_canSaveCounts)
            {
                @if (_editingName)
                {
                    <input class="cc-name-input"
                           @bind="_saveName"
                           @bind:event="oninput"
                           @onblur="StopEditingName"
                           @onkeydown="OnNameKeyDown"
                           placeholder="@Text["cashCounter.savePlaceholder"]"
                           id="cc-name-field" />
                }
                else
                {
                    <h2 class="cc-count-name" @onclick="StartEditingName">
                        @(string.IsNullOrWhiteSpace(_saveName) ? Text["cashCounter.savePlaceholder"] : _saveName)
                    </h2>
                }
            }

            @if (_canSelectCurrency)
            {
                <select id="currency" class="cc-toolbar-select" @onchange="OnCurrencyChanged">
                    @foreach (var currency in _currencies)
                    {
                        <option value="@currency.Code" selected="@(_selectedCurrency?.Code == currency.Code)">
                            @currency.Symbol @currency.Name
                        </option>
                    }
                </select>
            }
        </section>
    }

    @if (_selectedCurrency != null)
    {
        <div class="denomination-sections cc-sections-compact">
            <section class="denomination-section banknotes cc-section-card">
                <div class="cc-section-header">
                    <div>
                        <h2>@Text["cashCounter.banknotes"]</h2>
                        <p>@Text.Format("ledger.accounts.total", _selectedCurrency.Banknotes.Count)</p>
                    </div>
                </div>
                <div class="denomination-grid cc-denomination-grid">
                    @foreach (var note in _selectedCurrency.Banknotes)
                    {
                        <div class="denomination-card banknote cc-denomination-card">
                            <div class="cc-denomination-top">
                                <span class="denom-name">@note.DisplayName</span>
                                <span class="denom-subtotal">@FormatAmount(note.Total)</span>
                            </div>
                            <div class="quantity-controls cc-quantity-controls">
                                <button class="btn-minus" @onclick="() => Decrement(note)" disabled="@(note.Quantity <= 0)" aria-label="@($"Decrease {note.DisplayName}")">-</button>
                                <input type="number" min="0" max="9999" @bind="note.Quantity" @bind:event="oninput" class="quantity-input" aria-label="@($"Quantity for {note.DisplayName}")" />
                                <button class="btn-plus" @onclick="() => Increment(note)" aria-label="@($"Increase {note.DisplayName}")">+</button>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="denomination-section coins cc-section-card">
                <div class="cc-section-header">
                    <div>
                        <h2>@Text["cashCounter.coins"]</h2>
                        <p>@Text.Format("ledger.accounts.total", _selectedCurrency.Coins.Count)</p>
                    </div>
                </div>
                <div class="denomination-grid cc-denomination-grid cc-denomination-grid-coins">
                    @foreach (var coin in _selectedCurrency.Coins)
                    {
                        <div class="denomination-card coin cc-denomination-card cc-denomination-card-coin">
                            <div class="cc-denomination-top">
                                <span class="denom-name">@coin.DisplayName</span>
                                <span class="denom-subtotal">@FormatAmount(coin.Total)</span>
                            </div>
                            <div class="quantity-controls cc-quantity-controls">
                                <button class="btn-minus" @onclick="() => Decrement(coin)" disabled="@(coin.Quantity <= 0)" aria-label="@($"Decrease {coin.DisplayName}")">-</button>
                                <input type="number" min="0" max="9999" @bind="coin.Quantity" @bind:event="oninput" class="quantity-input" aria-label="@($"Quantity for {coin.DisplayName}")" />
                                <button class="btn-plus" @onclick="() => Increment(coin)" aria-label="@($"Increase {coin.DisplayName}")">+</button>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>

        <footer class="cc-sticky-footer" aria-live="polite">
            <div class="cc-footer-total">
                <span class="cc-total-footer-label">@Text["cashCounter.totalSummary"]</span>
                <strong class="cc-total-footer-amount">@FormatAmount(CalculateTotal())</strong>
            </div>
            <div class="cc-footer-actions">
                @if (_canSaveCounts)
                {
                    <button class="cc-circle-btn cc-circle-btn-save @(_showSaveSuccess ? "cc-circle-success" : "") @(_showSaveError ? "cc-circle-error" : "")"
                            @onclick="SaveCurrentCount"
                            disabled="@(CalculateTotal() == 0)"
                            title="@Text["cashCounter.save"]"
                            aria-label="@Text["cashCounter.save"]">
                        @(_showSaveSuccess ? "✓" : _showSaveError ? "✕" : "💾")
                    </button>
                }
                <button class="cc-circle-btn cc-circle-btn-clear" @onclick="ClearAll" title="@Text["cashCounter.clearAll"]" aria-label="@Text["cashCounter.clearAll"]">✕</button>
            </div>
        </footer>
    }
</div>

@code {
    private List<Currency> _currencies = Currency.GetAllCurrencies();
    private Currency? _selectedCurrency;
    private string _saveName = string.Empty;
    private bool _showSaveSuccess = false;
    private bool _showSaveError = false;
    private bool _editingName = false;

    private bool _canSelectCurrency = false;
    private bool _canSaveCounts = false;
    private bool _canLoadCounts = false;

    protected override async Task OnInitializedAsync()
    {
        Text.Changed += OnTextChanged;
        _selectedCurrency = _currencies.FirstOrDefault()
            ?? throw new InvalidOperationException("No currencies available. Currency list must not be empty.");

        _canSelectCurrency = await PremiumService.IsFeatureEnabledAsync(PremiumFeature.CurrencySelection);
        _canSaveCounts = await PremiumService.IsFeatureEnabledAsync(PremiumFeature.SaveCounts);
        _canLoadCounts = await PremiumService.IsFeatureEnabledAsync(PremiumFeature.LoadCounts);

        if (_canLoadCounts)
        {
            var uri = new Uri(NavigationManager.Uri);
            var loadId = GetQueryParameter(uri.Query, "load");
            if (!string.IsNullOrEmpty(loadId))
            {
                var savedCount = await StorageService.GetByIdAsync(loadId);
                if (savedCount != null)
                    LoadSavedCount(savedCount);
            }
        }
    }

    private void OnTextChanged() => InvokeAsync(StateHasChanged);

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrEmpty(query))
            return null;

        var queryString = query.TrimStart('?');
        var pairs = queryString.Split('&');
        foreach (var pair in pairs)
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && parts[0].Equals(key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(parts[1]);
            }
        }
        return null;
    }

    private void OnCurrencyChanged(ChangeEventArgs e)
    {
        var code = e.Value?.ToString();
        _selectedCurrency = _currencies.FirstOrDefault(c => c.Code == code);
        ClearAll();
    }

    private decimal CalculateTotal()
    {
        if (_selectedCurrency == null) return 0;
        return CalculateBanknotesTotal() + CalculateCoinsTotal();
    }

    private decimal CalculateBanknotesTotal() => _selectedCurrency?.Banknotes.Sum(n => n.Total) ?? 0;
    private decimal CalculateCoinsTotal() => _selectedCurrency?.Coins.Sum(c => c.Total) ?? 0;

    private const int MaxQuantity = 9999;

    private void Increment(Denomination denom)
    {
        if (denom.Quantity < MaxQuantity)
            denom.Quantity++;
    }

    private void Decrement(Denomination denom)
    {
        if (denom.Quantity > 0)
            denom.Quantity--;
    }

    private void ClearAll()
    {
        if (_selectedCurrency == null) return;

        foreach (var note in _selectedCurrency.Banknotes)
            note.Quantity = 0;

        foreach (var coin in _selectedCurrency.Coins)
            coin.Quantity = 0;

        _saveName = string.Empty;
    }

    private async Task SaveCurrentCount()
    {
        if (_selectedCurrency == null || CalculateTotal() == 0)
            return;

        var savedCount = new SavedCount
        {
            Name = string.IsNullOrWhiteSpace(_saveName)
                ? $"Count {DateTime.Now.ToString("g", Text.CurrentCulture)}"
                : _saveName,
            SavedAt = DateTime.UtcNow,
            CurrencyCode = _selectedCurrency.Code,
            CurrencySymbol = _selectedCurrency.Symbol,
            TotalAmount = CalculateTotal(),
            BanknotesTotal = CalculateBanknotesTotal(),
            CoinsTotal = CalculateCoinsTotal(),
            Denominations = new List<DenominationCount>()
        };

        foreach (var note in _selectedCurrency.Banknotes.Where(n => n.Quantity > 0))
        {
            savedCount.Denominations.Add(new DenominationCount
            {
                Value = note.Value,
                DisplayName = note.DisplayName,
                Quantity = note.Quantity,
                IsCoin = false
            });
        }

        foreach (var coin in _selectedCurrency.Coins.Where(c => c.Quantity > 0))
        {
            savedCount.Denominations.Add(new DenominationCount
            {
                Value = coin.Value,
                DisplayName = coin.DisplayName,
                Quantity = coin.Quantity,
                IsCoin = true
            });
        }

        try
        {
            await StorageService.SaveCountAsync(savedCount);
            _showSaveSuccess = true;
            StateHasChanged();
            await Task.Delay(2000);
            _showSaveSuccess = false;
            _saveName = string.Empty;
        }
        catch
        {
            _showSaveError = true;
            StateHasChanged();
            await Task.Delay(2000);
            _showSaveError = false;
        }
        StateHasChanged();
    }

    public void LoadSavedCount(SavedCount saved)
    {
        _selectedCurrency = _currencies.FirstOrDefault(c => c.Code == saved.CurrencyCode);
        if (_selectedCurrency == null) return;

        ClearAll();

        foreach (var savedDenom in saved.Denominations)
        {
            if (savedDenom.IsCoin)
            {
                var coin = _selectedCurrency.Coins.FirstOrDefault(c => c.Value == savedDenom.Value);
                if (coin != null) coin.Quantity = savedDenom.Quantity;
            }
            else
            {
                var note = _selectedCurrency.Banknotes.FirstOrDefault(n => n.Value == savedDenom.Value);
                if (note != null) note.Quantity = savedDenom.Quantity;
            }
        }

        StateHasChanged();
    }

    private string FormatAmount(decimal amount)
    {
        if (_selectedCurrency == null)
            return amount.ToString("N2", Text.CurrentCulture);

        return $"{_selectedCurrency.Symbol} {amount.ToString("N2", Text.CurrentCulture)}";
    }

    private void StartEditingName()
    {
        _editingName = true;
        StateHasChanged();
    }

    private void StopEditingName()
    {
        _editingName = false;
        StateHasChanged();
    }

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Escape")
            StopEditingName();
    }

    public void Dispose()
    {
        Text.Changed -= OnTextChanged;
    }
}
