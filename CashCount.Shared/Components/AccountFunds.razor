@using System.Globalization
@using CashCount.Shared.Models
@using CashCount.Shared.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IStorageService StorageService

<div class="account-funds account-funds-minimal">
    <section class="af-hero-strip">
        <div>
            <p class="af-eyebrow">Funds</p>
            <div class="af-hero-balance @( _ledger.TotalBalance >= 0 ? "positive" : "negative")">@FormatAmount(_ledger.TotalBalance)</div>
            <div class="af-hero-meta">
                <span>@_ledger.Accounts.Count account(s)</span>
                <span>Net @FormatSignedAmount(_ledger.NetFlow)</span>
            </div>
        </div>
    </section>

    @if (!_ledger.Accounts.Any())
    {
        <section class="af-panel af-empty-hero af-minimal-empty">
            <div class="tc-empty-state af-inline-empty af-hero-empty-state">
                <span class="tc-empty-icon">🏦</span>
                <h3>No accounts yet</h3>
                <p>Create your first cash box, bank account, or fund bucket on the Account page. This screen becomes your fast snapshot once at least one account exists.</p>
                <div class="af-empty-actions">
                    <a class="btn-save af-link-btn" href="/account">Create first account</a>
                </div>
            </div>
        </section>
    }
    else
    {
        <details class="af-panel af-collapsible-panel" open>
            <summary class="af-collapsible-summary">
                <div class="af-section-heading-row af-collapsible-heading">
                    <div>
                        <h3>Accounts</h3>
                        <p>Live balances first.</p>
                    </div>
                    <span class="count-badge">@_ledger.CurrencySymbol default</span>
                </div>
            </summary>

            <div class="af-account-list af-account-list-compact">
                @foreach (var account in SortedAccounts)
                {
                    var balance = _ledger.GetAccountBalance(account.Id);
                    <div class="af-account-card af-account-card-compact af-account-card-readonly">
                        <div class="af-account-main af-account-main-compact">
                            <div>
                                <div class="af-account-title-row">
                                    <strong>@account.Name</strong>
                                    <span class="af-kind-badge">@account.Kind</span>
                                </div>
                                <div class="af-account-meta af-account-meta-compact">
                                    <span>@_ledger.GetTransactionCount(account.Id) tx</span>
                                </div>
                            </div>
                            <div class="af-account-balance @(balance >= 0 ? "positive" : "negative")">@FormatAmount(balance)</div>
                        </div>
                    </div>
                }
            </div>
        </details>

        <details class="af-panel af-visual-panel af-collapsible-panel" open>
            <summary class="af-collapsible-summary">
                <div class="af-section-heading-row af-section-heading-row-tight af-collapsible-heading">
                    <div>
                        <h3>Flow</h3>
                        <p>Income, expenses, and balance at a glance.</p>
                    </div>
                    <div class="af-flow-badge @( _ledger.NetFlow >= 0 ? "positive" : "negative")">@FormatSignedAmount(_ledger.NetFlow)</div>
                </div>
            </summary>

            <div class="af-visual-grid">
                <div class="af-visual-card incoming">
                    <span class="af-summary-label">Income</span>
                    <strong>@FormatAmount(_ledger.TotalIncoming)</strong>
                    <div class="af-meter-track">
                        <div class="af-meter-fill incoming" style="width:@IncomeFillPercent%"></div>
                    </div>
                    <small>@_ledger.Transactions.Count(t => t.Direction == CashFlowDirection.Incoming) entry(s)</small>
                </div>

                <div class="af-visual-card outgoing">
                    <span class="af-summary-label">Expenses</span>
                    <strong>@FormatAmount(_ledger.TotalOutgoing)</strong>
                    <div class="af-meter-track">
                        <div class="af-meter-fill outgoing" style="width:@OutgoingFillPercent%"></div>
                    </div>
                    <small>@_ledger.Transactions.Count(t => t.Direction == CashFlowDirection.Outgoing) entry(s)</small>
                </div>

                <div class="af-visual-card balance">
                    <span class="af-summary-label">Balance</span>
                    <strong class="@(_ledger.TotalBalance >= 0 ? "positive" : "negative")">@FormatAmount(_ledger.TotalBalance)</strong>
                    <div class="af-balance-split af-balance-split-single">
                        <div>
                            <span class="af-summary-label">Activity</span>
                            <strong class="@(_ledger.NetFlow >= 0 ? "positive" : "negative")">@FormatSignedAmount(_ledger.NetFlow)</strong>
                        </div>
                    </div>
                </div>
            </div>
        </details>
    }

    <div class="af-content-grid bottom af-content-grid-minimal">
        <details class="af-panel af-collapsible-panel" open>
            <summary class="af-collapsible-summary">
                <div class="af-panel-header af-panel-header-minimal af-collapsible-heading">
                    <div>
                        <h3>Category overview</h3>
                        <p>Where money comes from and where it goes.</p>
                    </div>
                </div>
            </summary>

            @if (CategorySummaries.Any())
            {
                <div class="af-category-overview-grid">
                    <div class="af-category-chart-card">
                        <div class="af-category-donut-shell">
                            <div class="af-category-donut" style="background:@CategoryChartStyle;">
                                <div class="af-category-donut-hole">
                                    <span class="af-summary-label">Tracked</span>
                                    <strong>@VisibleCategorySummaries.Count</strong>
                                    <small>categories</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="af-category-list af-category-list-chart">
                        @foreach (var category in VisibleCategorySummaries)
                        {
                            <div class="af-category-item">
                                <div class="af-category-main">
                                    <div class="af-category-title-row">
                                        <span class="af-category-swatch" style="background:@GetCategoryColor(category.Category)"></span>
                                        <strong>@category.Category</strong>
                                    </div>
                                    <div class="af-category-meta">
                                        <span>@FormatPercent(CategoryShare(category)) of activity</span>
                                        <span class="positive">In @FormatAmount(category.Incoming)</span>
                                        <span class="negative">Out @FormatAmount(category.Outgoing)</span>
                                    </div>
                                </div>
                                <div class="af-category-net @(category.Net >= 0 ? "positive" : "negative")">@FormatSignedAmount(category.Net)</div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="tc-empty-state af-inline-empty">
                    <span class="tc-empty-icon">📊</span>
                    <p>Categories appear once transactions start using them.</p>
                </div>
            }
        </details>

        <details class="af-panel af-collapsible-panel" open>
            <summary class="af-collapsible-summary">
                <div class="af-panel-header af-panel-header-minimal af-collapsible-heading">
                    <div>
                        <h3>Recent</h3>
                        <p>Latest movements across all tracked accounts.</p>
                    </div>
                    <span class="count-badge">@_ledger.Transactions.Count total</span>
                </div>
            </summary>

            @if (_ledger.Transactions.Any())
            {
                <div class="af-transaction-list">
                    @foreach (var transaction in RecentTransactions)
                    {
                        var accountName = _ledger.Accounts.FirstOrDefault(a => a.Id == transaction.AccountId)?.Name ?? "Unknown account";
                        <div class="tc-entry @(transaction.Direction == CashFlowDirection.Incoming ? "income" : "expense")">
                            <div class="tc-entry-type-bar"></div>
                            <div class="tc-entry-body">
                                <div class="tc-entry-top">
                                    <div class="af-transaction-main">
                                        <div>
                                            <span class="tc-entry-desc">@transaction.Description</span>
                                            <div class="af-transaction-account">@accountName</div>
                                        </div>
                                        @if (transaction.HasAttachment)
                                        {
                                            <div class="af-transaction-attachment-preview">
                                                <img src="@transaction.AttachmentDataUrl" alt="Attachment for @transaction.Description" class="af-transaction-thumb" />
                                            </div>
                                        }
                                    </div>
                                    <span class="tc-entry-amount @(transaction.Direction == CashFlowDirection.Incoming ? "income" : "expense")">
                                        @(transaction.Direction == CashFlowDirection.Incoming ? "+" : "-")@FormatAmount(transaction.Amount, includeCurrency: false)
                                    </span>
                                </div>
                                <div class="tc-entry-bottom">
                                    <span class="tc-entry-meta">
                                        @if (!string.IsNullOrWhiteSpace(transaction.Category))
                                        {
                                            <span class="tc-entry-category">@transaction.Category</span>
                                        }
                                        @if (transaction.HasAttachment)
                                        {
                                            <span class="af-attachment-chip">Photo</span>
                                        }
                                        <span class="tc-entry-date">@transaction.Date.ToString("dd.MM.yyyy")</span>
                                    </span>
                                    <button class="tc-btn-delete" @onclick="() => DeleteTransaction(transaction.Id)">✕</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="tc-empty-state af-inline-empty af-inline-empty-tight">
                    <span class="tc-empty-icon">🧾</span>
                    <p>No transactions yet. Use the add button to log the first movement.</p>
                </div>
            }
        </details>
    </div>

    @if (_ledger.Accounts.Any())
    {
        <button class="af-fab" @onclick="() => OpenTransactionModal(CashFlowDirection.Outgoing)" aria-label="Add transaction">
            <span>+</span>
        </button>
    }
</div>

@if (_showTransactionModal)
{
    <div class="af-modal-backdrop" @onclick="CloseTransactionModal">
        <div class="af-modal-card af-modal-card-wide" @onclick:stopPropagation="true">
            <div class="af-modal-header af-modal-header-simple">
                <h3>Add transaction</h3>
            </div>

            <div class="tc-segmented-toggle" role="group" aria-label="Transaction type">
                <button type="button"
                        class="tc-segmented-btn @(_newTransaction.Direction == CashFlowDirection.Outgoing ? "active expense" : string.Empty)"
                        @onclick='() => SetTransactionDirection(CashFlowDirection.Outgoing)'>Outgoing</button>
                <button type="button"
                        class="tc-segmented-btn @(_newTransaction.Direction == CashFlowDirection.Incoming ? "active income" : string.Empty)"
                        @onclick='() => SetTransactionDirection(CashFlowDirection.Incoming)'>Incoming</button>
            </div>

            <div class="af-form-grid">
                <select class="af-select" @bind="_newTransaction.AccountId">
                    @foreach (var account in _ledger.Accounts.OrderBy(a => a.Name))
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </select>
                <input class="tc-input" @bind="_newTransaction.Description" @bind:event="oninput" placeholder="Description" />
                <input class="tc-input" type="number" min="0" step="0.01" @bind="_newTransactionAmount" @bind:event="oninput" placeholder="Amount" />
                <input class="tc-input" list="transaction-categories" @bind="_newTransaction.Category" @bind:event="oninput" placeholder="Category" />
                <input class="tc-input" type="date" @bind="_newTransaction.Date" @bind:event="oninput" />
                <input class="tc-input" @bind="_newTransaction.Notes" @bind:event="oninput" placeholder="Optional note" />
            </div>

            <section class="af-attachment-section">
                <div class="af-attachment-header">
                    <div>
                        <h4>Picture</h4>
                        <p>One optional image, resized before saving.</p>
                    </div>
                    @if (_newTransaction.HasAttachment)
                    {
                        <span class="af-attachment-chip">Attached</span>
                    }
                </div>

                <div class="af-attachment-inputs" @key="_attachmentInputVersion">
                    <InputFile id="transaction-photo-picker"
                               class="af-hidden-file-input"
                               OnChange="HandleAttachmentSelected"
                               accept="image/*" />
                    <InputFile id="transaction-camera-picker"
                               class="af-hidden-file-input"
                               OnChange="HandleAttachmentSelected"
                               accept="image/*"
                               capture="environment" />
                </div>

                <div class="af-attachment-inline-control @(_newTransaction.HasAttachment ? "has-value" : string.Empty)">
                    <span class="af-attachment-inline-value">@AttachmentInputLabel</span>
                    <div class="af-attachment-inline-actions">
                        <label class="af-inline-icon-btn" for="transaction-photo-picker" title="Choose from files or gallery" aria-label="Choose from files or gallery">🖼️</label>
                        <label class="af-inline-icon-btn" for="transaction-camera-picker" title="Take a photo" aria-label="Take a photo">📷</label>
                        @if (_newTransaction.HasAttachment)
                        {
                            <button type="button" class="af-inline-icon-btn af-inline-icon-btn-danger" @onclick="RemoveAttachment" title="Remove picture" aria-label="Remove picture">✕</button>
                        }
                    </div>
                </div>

                @if (_newTransaction.HasAttachment)
                {
                    <div class="af-attachment-preview-card">
                        <img src="@_newTransaction.AttachmentDataUrl" alt="Selected transaction picture" class="af-attachment-preview-image" />
                        <div class="af-attachment-actions">
                            <label class="af-link-action" for="transaction-photo-picker">Replace picture</label>
                            <label class="af-link-action" for="transaction-camera-picker">Take new</label>
                            <button type="button" class="af-link-action af-link-action-danger" @onclick="RemoveAttachment">Remove</button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="af-attachment-helper">Add a receipt, invoice, or reference photo.</p>
                }

                @if (!string.IsNullOrWhiteSpace(_attachmentError))
                {
                    <p class="af-form-error">@_attachmentError</p>
                }
            </section>

            <datalist id="transaction-categories">
                @foreach (var category in SuggestedCategories)
                {
                    <option value="@category"></option>
                }
            </datalist>

            <div class="af-modal-actions">
                <button class="btn-clear af-modal-cancel" @onclick="CloseTransactionModal">Cancel</button>
                <button class="tc-btn-add @(_newTransaction.Direction == CashFlowDirection.Incoming ? "income" : "expense")"
                        @onclick="AddTransaction"
                        disabled="@(!CanAddTransaction)">
                    + Add @(_newTransaction.Direction == CashFlowDirection.Incoming ? "incoming" : "outgoing")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const long MaxAttachmentBytes = 600 * 1024;
    private const int AttachmentMaxDimension = 1280;

    private AccountLedger _ledger = new();
    private AccountTransaction _newTransaction = new();
    private string _newTransactionAmount = string.Empty;
    private bool _showTransactionModal;
    private string? _attachmentError;
    private int _attachmentInputVersion;

    private static readonly string[] _defaultCategories =
    {
        "Salary", "Sales", "Top-up", "Cash Deposit", "Rent", "Groceries", "Transport", "Fuel",
        "Eating Out", "Supplies", "Fees", "Savings", "Investment", "Emergency", "Travel", "Misc"
    };

    private static readonly string[] _categoryPalette =
    {
        "#2563eb", "#14b8a6", "#f97316", "#8b5cf6", "#ec4899", "#22c55e", "#eab308", "#06b6d4"
    };

    protected override async Task OnInitializedAsync()
    {
        _ledger = await StorageService.GetAccountLedgerAsync();

        if (!_ledger.Accounts.Any() && !_ledger.Transactions.Any())
        {
            _ledger.Name = "Accounts Overview";
        }

        PrepareNewTransaction();
    }

    private IEnumerable<TrackedAccount> SortedAccounts => _ledger.Accounts
        .OrderByDescending(a => _ledger.GetAccountBalance(a.Id))
        .ThenBy(a => a.Name);

    private IEnumerable<AccountTransaction> RecentTransactions => _ledger.Transactions
        .OrderByDescending(t => t.Date)
        .ThenByDescending(t => t.Id)
        .Take(12);

    private IReadOnlyList<CategorySummary> VisibleCategorySummaries => CategorySummaries.Take(5).ToList();

    private IEnumerable<CategorySummary> CategorySummaries => _ledger.GetCategorySummaries();

    private IEnumerable<string> SuggestedCategories => _defaultCategories
        .Concat(_ledger.Transactions.Where(t => !string.IsNullOrWhiteSpace(t.Category)).Select(t => t.Category.Trim()))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(category => category);

    private decimal ActivityMax => Math.Max(_ledger.TotalIncoming, _ledger.TotalOutgoing);
    private decimal CategoryActivityTotal => VisibleCategorySummaries.Sum(category => category.TotalActivity);
    private string IncomeFillPercent => ActivityMax <= 0 ? "0" : ((double)(_ledger.TotalIncoming / ActivityMax) * 100d).ToString("0.#", CultureInfo.InvariantCulture);
    private string OutgoingFillPercent => ActivityMax <= 0 ? "0" : ((double)(_ledger.TotalOutgoing / ActivityMax) * 100d).ToString("0.#", CultureInfo.InvariantCulture);
    private string CategoryChartStyle => BuildCategoryChartStyle();
    private string AttachmentInputLabel => _newTransaction.HasAttachment
        ? _newTransaction.AttachmentFileName ?? "Attached picture"
        : "Add receipt or photo";

    private bool CanAddTransaction =>
        !string.IsNullOrWhiteSpace(_newTransaction.AccountId) &&
        !string.IsNullOrWhiteSpace(_newTransaction.Description) &&
        decimal.TryParse(_newTransactionAmount, NumberStyles.Any, CultureInfo.InvariantCulture, out var amount) &&
        amount > 0;

    private void OpenTransactionModal(CashFlowDirection direction)
    {
        if (!_ledger.Accounts.Any())
            return;

        if (string.IsNullOrWhiteSpace(_newTransaction.AccountId) || !_ledger.Accounts.Any(a => a.Id == _newTransaction.AccountId))
        {
            PrepareNewTransaction();
        }

        _attachmentError = null;
        _newTransaction.Direction = direction;
        _showTransactionModal = true;
    }

    private void CloseTransactionModal()
    {
        _attachmentError = null;
        _showTransactionModal = false;
    }

    private void SetTransactionDirection(CashFlowDirection direction)
    {
        _newTransaction.Direction = direction;
    }

    private async Task HandleAttachmentSelected(InputFileChangeEventArgs args)
    {
        _attachmentError = null;

        var file = args.File;
        if (file is null)
            return;

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _attachmentError = "Please select an image file.";
            return;
        }

        try
        {
            var processedFile = await file.RequestImageFileAsync("image/jpeg", AttachmentMaxDimension, AttachmentMaxDimension);
            await using var stream = processedFile.OpenReadStream(MaxAttachmentBytes);
            await using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            if (memoryStream.Length == 0)
            {
                _attachmentError = "The selected image could not be read.";
                return;
            }

            var imageBase64 = Convert.ToBase64String(memoryStream.ToArray());
            _newTransaction.AttachmentDataUrl = $"data:image/jpeg;base64,{imageBase64}";
            _newTransaction.AttachmentFileName = string.IsNullOrWhiteSpace(file.Name) ? "transaction-photo.jpg" : file.Name;
        }
        catch (IOException)
        {
            _attachmentError = "That image is still too large after resizing. Try a smaller photo.";
            RemoveAttachment(resetPicker: false);
        }
        catch (ObjectDisposedException)
        {
            _attachmentError = "The image picker closed before the photo finished loading. Please try again.";
            RemoveAttachment(resetPicker: false);
        }
        catch (Exception)
        {
            _attachmentError = "Could not attach that image on this device/browser.";
            RemoveAttachment(resetPicker: false);
        }
    }

    private void RemoveAttachment()
    {
        RemoveAttachment(resetPicker: true);
    }

    private void RemoveAttachment(bool resetPicker)
    {
        _newTransaction.AttachmentDataUrl = null;
        _newTransaction.AttachmentFileName = null;

        if (resetPicker)
        {
            ResetAttachmentPicker();
        }
    }

    private void ResetAttachmentPicker()
    {
        _attachmentInputVersion++;
    }

    private async Task AddTransaction()
    {
        if (!CanAddTransaction)
            return;

        if (!decimal.TryParse(_newTransactionAmount, NumberStyles.Any, CultureInfo.InvariantCulture, out var amount))
            return;

        _newTransaction.Amount = amount;
        _ledger.Transactions.Add(_newTransaction);

        var direction = _newTransaction.Direction;
        var date = _newTransaction.Date;
        var accountId = _newTransaction.AccountId;
        _newTransaction = new AccountTransaction
        {
            Direction = direction,
            Date = date,
            AccountId = accountId
        };
        _newTransactionAmount = string.Empty;
        _attachmentError = null;
        _showTransactionModal = false;
        ResetAttachmentPicker();

        await PersistLedger();
    }

    private async Task DeleteTransaction(string transactionId)
    {
        _ledger.Transactions.RemoveAll(transaction => transaction.Id == transactionId);
        await PersistLedger();
    }

    private void PrepareNewTransaction()
    {
        var selectedAccountId = _newTransaction.AccountId;
        var firstAccountId = _ledger.Accounts.FirstOrDefault()?.Id ?? string.Empty;

        if (string.IsNullOrWhiteSpace(selectedAccountId) || !_ledger.Accounts.Any(a => a.Id == selectedAccountId))
        {
            selectedAccountId = firstAccountId;
        }

        _newTransaction = new AccountTransaction
        {
            AccountId = selectedAccountId,
            Date = DateTime.Today,
            Direction = _newTransaction.Direction
        };

        _attachmentError = null;
        ResetAttachmentPicker();
    }

    private async Task PersistLedger()
    {
        await StorageService.SaveAccountLedgerAsync(_ledger);
    }

    private decimal CategoryShare(CategorySummary category)
    {
        if (CategoryActivityTotal <= 0)
            return 0m;

        return category.TotalActivity / CategoryActivityTotal;
    }

    private string GetCategoryColor(string category)
    {
        var index = VisibleCategorySummaries.Select(summary => summary.Category).ToList().FindIndex(name => name.Equals(category, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
            index = 0;

        return _categoryPalette[index % _categoryPalette.Length];
    }

    private string BuildCategoryChartStyle()
    {
        if (!VisibleCategorySummaries.Any() || CategoryActivityTotal <= 0)
            return "conic-gradient(#e2e8f0 0 100%)";

        var segments = new List<string>();
        decimal start = 0m;

        for (var i = 0; i < VisibleCategorySummaries.Count; i++)
        {
            var category = VisibleCategorySummaries[i];
            var share = CategoryShare(category);
            var end = i == VisibleCategorySummaries.Count - 1 ? 1m : start + share;

            var startPercent = (start * 100m).ToString("0.##", CultureInfo.InvariantCulture);
            var endPercent = (end * 100m).ToString("0.##", CultureInfo.InvariantCulture);
            segments.Add($"{GetCategoryColor(category.Category)} {startPercent}% {endPercent}%");
            start = end;
        }

        return $"conic-gradient({string.Join(", ", segments)})";
    }

    private string FormatAmount(decimal amount, bool includeCurrency = true)
    {
        var number = amount.ToString("N2", CultureInfo.InvariantCulture);
        return includeCurrency ? $"{_ledger.CurrencySymbol} {number}" : number;
    }

    private string FormatSignedAmount(decimal amount)
    {
        var prefix = amount >= 0 ? "+" : "-";
        return $"{prefix}{_ledger.CurrencySymbol} {Math.Abs(amount).ToString("N2", CultureInfo.InvariantCulture)}";
    }

    private string FormatPercent(decimal value)
    {
        return value.ToString("P0", CultureInfo.InvariantCulture);
    }
}
