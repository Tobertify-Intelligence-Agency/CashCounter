@using System.Globalization
@using CashCount.Shared.Models
@using CashCount.Shared.Services
@using CashCount.Shared.Services.Localization
@inject IStorageService StorageService
@inject IAppTextService Text
@implements IDisposable

<section class="af-management-shell af-management-shell-minimal">
    <section class="af-header-card af-management-header af-management-header-minimal">
        <div>
            <p class="af-eyebrow">@Text["ledger.hero.eyebrow"]</p>
            <h2>@Text["ledger.hero.title"]</h2>
            <p class="af-subtitle">@Text["ledger.hero.body"]</p>
        </div>

        <div class="af-header-actions af-header-actions-tight">
            <select class="af-select af-currency-select" @onchange="OnCurrencyChanged">
                @foreach (var currency in _currencies)
                {
                    <option value="@currency.Symbol" selected="@(_ledger.CurrencySymbol == currency.Symbol)">@currency.Label</option>
                }
            </select>
            <button class="btn-save af-header-cta" @onclick="OpenAccountModal">@Text["ledger.create"]</button>
            <button class="btn-clear" @onclick="ResetLedger" disabled="@(!_ledger.Accounts.Any() && !_ledger.Transactions.Any())">@Text["ledger.reset"]</button>
        </div>
    </section>

    <div class="af-dashboard-grid af-dashboard-grid-compact af-dashboard-grid-minimal">
        <div class="af-stat-card primary">
            <span class="af-stat-label">@Text["ledger.stats.accounts"]</span>
            <strong>@_ledger.Accounts.Count</strong>
            <small>@Text.Format("ledger.stats.liveBalance", FormatAmount(_ledger.TotalBalance))</small>
        </div>
        <div class="af-stat-card neutral">
            <span class="af-stat-label">@Text["ledger.stats.opening"]</span>
            <strong>@FormatAmount(_ledger.TotalOpeningBalance)</strong>
            <small>@Text["ledger.stats.openingBody"]</small>
        </div>
        <div class="af-stat-card success">
            <span class="af-stat-label">@Text["ledger.stats.transactions"]</span>
            <strong>@_ledger.Transactions.Count</strong>
            <small>@Text["ledger.stats.transactionsBody"]</small>
        </div>
    </div>

    <div class="af-content-grid af-management-grid af-management-grid-minimal">
        <section class="af-panel af-panel-dense">
            <div class="af-panel-header af-panel-header-minimalized">
                <div>
                    <h3>@Text["ledger.accounts.title"]</h3>
                    <p>@Text["ledger.accounts.body"]</p>
                </div>
                <div class="af-panel-actions">
                    <span class="count-badge">@Text.Format("ledger.accounts.total", _ledger.Accounts.Count)</span>
                    <button class="btn-save af-inline-action" @onclick="OpenAccountModal">+ Add</button>
                </div>
            </div>

            @if (_ledger.Accounts.Any())
            {
                <div class="af-account-list af-account-list-compact">
                    @foreach (var account in _ledger.Accounts.OrderByDescending(a => _ledger.GetAccountBalance(a.Id)).ThenBy(a => a.Name))
                    {
                        var balance = _ledger.GetAccountBalance(account.Id);
                        <div class="af-account-card af-account-card-compact">
                            <div class="af-account-main af-account-main-compact">
                                <div>
                                    <div class="af-account-title-row">
                                        <strong>@account.Name</strong>
                                        <span class="af-kind-badge">@account.Kind</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(account.Notes))
                                    {
                                        <p class="af-account-note">@account.Notes</p>
                                    }
                                    <div class="af-account-meta af-account-meta-compact">
                                        <span>@Text.Format("ledger.account.opening", FormatAmount(account.OpeningBalance))</span>
                                        <span>@Text.Format("ledger.account.transactions", _ledger.GetTransactionCount(account.Id))</span>
                                    </div>
                                </div>
                                <div class="af-account-actions-stack">
                                    <div class="af-account-balance @(balance >= 0 ? "positive" : "negative")">@FormatAmount(balance)</div>
                                    <button class="btn-delete-single" @onclick="() => DeleteAccount(account.Id)">@Text["app.delete"]</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="tc-empty-state af-inline-empty af-inline-empty-card">
                    <span class="tc-empty-icon">🏦</span>
                    <p>@Text["ledger.empty.body"]</p>
                    <button class="btn-save af-empty-action" @onclick="OpenAccountModal">@Text["ledger.empty.action"]</button>
                </div>
            }
        </section>

        <section class="af-panel af-management-side-panel af-panel-dense">
            <div class="af-panel-header af-panel-header-minimalized">
                <div>
                    <h3>@Text["ledger.guide.title"]</h3>
                    <p>@Text["ledger.guide.body"]</p>
                </div>
            </div>

            <div class="af-management-notes af-management-notes-tight">
                <div class="af-management-note">
                    <span class="af-summary-label">@Text["ledger.step1.title"]</span>
                    <p>@Text["ledger.step1.body"]</p>
                </div>
                <div class="af-management-note">
                    <span class="af-summary-label">@Text["ledger.step2.title"]</span>
                    <p>@Text["ledger.step2.body"]</p>
                </div>
                <div class="af-management-note">
                    <span class="af-summary-label">@Text["ledger.step3.title"]</span>
                    <p>@Text["ledger.step3.body"]</p>
                </div>
            </div>

            <div class="af-panel-summary af-panel-summary-dense">
                <div>
                    <span class="af-summary-label">@Text["ledger.currentCurrency"]</span>
                    <strong>@_ledger.CurrencySymbol</strong>
                </div>
                <div>
                    <span class="af-summary-label">@Text["ledger.latestTransaction"]</span>
                    <strong>@(_ledger.Transactions.OrderByDescending(t => t.Date).FirstOrDefault()?.Date.ToString("d", Text.CurrentCulture) ?? "—")</strong>
                </div>
                <div>
                    <span class="af-summary-label">@Text["ledger.nextAction"]</span>
                    <strong>@(_ledger.Accounts.Any() ? Text["ledger.nextAction.funds"] : Text["ledger.nextAction.create"])</strong>
                </div>
            </div>

            <a class="btn-clear af-link-btn af-management-link" href="/funds">@Text["ledger.openFunds"]</a>
        </section>
    </div>
</section>

@if (_showAccountModal)
{
    <div class="af-modal-backdrop" @onclick="CloseAccountModal">
        <div class="af-modal-card" @onclick:stopPropagation="true">
            <div class="af-modal-header">
                <div>
                    <p class="af-modal-eyebrow">@Text["ledger.modal.eyebrow"]</p>
                    <h3>@Text["ledger.modal.title"]</h3>
                    <p>@Text["ledger.modal.body"]</p>
                </div>
                <button class="af-modal-close" @onclick="CloseAccountModal" aria-label="Close">✕</button>
            </div>

            <div class="af-form-grid compact">
                <input class="tc-input" @bind="_newAccount.Name" @bind:event="oninput" placeholder="@Text["ledger.field.accountName"]" />
                <select class="af-select" @bind="_newAccount.Kind">
                    @foreach (var kind in Enum.GetValues<AccountKind>())
                    {
                        <option value="@kind">@kind</option>
                    }
                </select>
                <input class="tc-input" type="number" min="0" step="0.01" @bind="_newAccountOpeningBalance" @bind:event="oninput" placeholder="@Text["ledger.field.openingBalance"]" />
                <input class="tc-input" @bind="_newAccount.Notes" @bind:event="oninput" placeholder="@Text["ledger.field.note"]" />
            </div>

            <div class="af-modal-actions">
                <button class="btn-clear" @onclick="CloseAccountModal">@Text["app.cancel"]</button>
                <button class="btn-save" @onclick="AddAccount" disabled="@(!CanAddAccount)">@Text["ledger.createButton"]</button>
            </div>
        </div>
    </div>
}

@code {
    private AccountLedger _ledger = new();
    private TrackedAccount _newAccount = new();
    private string _newAccountOpeningBalance = string.Empty;
    private bool _showAccountModal;

    private static readonly List<(string Symbol, string Label)> _currencies = new()
    {
        ("€", "€ EUR"),
        ("$", "$ USD"),
        ("£", "£ GBP"),
        ("CHF", "CHF"),
        ("CA$", "CA$ CAD"),
        ("A$", "A$ AUD")
    };

    protected override async Task OnInitializedAsync()
    {
        Text.Changed += OnTextChanged;
        _ledger = await StorageService.GetAccountLedgerAsync();
    }

    private void OnTextChanged() => InvokeAsync(StateHasChanged);

    private bool CanAddAccount =>
        !string.IsNullOrWhiteSpace(_newAccount.Name) &&
        decimal.TryParse(_newAccountOpeningBalance, NumberStyles.Any, CultureInfo.InvariantCulture, out _);

    private void OpenAccountModal() => _showAccountModal = true;
    private void CloseAccountModal() => _showAccountModal = false;

    private async Task AddAccount()
    {
        if (!CanAddAccount)
            return;

        if (!decimal.TryParse(_newAccountOpeningBalance, NumberStyles.Any, CultureInfo.InvariantCulture, out var openingBalance))
            return;

        _newAccount.OpeningBalance = openingBalance;
        _ledger.Accounts.Add(_newAccount);

        _newAccount = new TrackedAccount();
        _newAccountOpeningBalance = string.Empty;
        _showAccountModal = false;

        await PersistLedger();
    }

    private async Task DeleteAccount(string accountId)
    {
        _ledger.Accounts.RemoveAll(account => account.Id == accountId);
        _ledger.Transactions.RemoveAll(transaction => transaction.AccountId == accountId);
        await PersistLedger();
    }

    private async Task ResetLedger()
    {
        _ledger = new AccountLedger
        {
            CurrencySymbol = _ledger.CurrencySymbol
        };
        _newAccount = new TrackedAccount();
        _newAccountOpeningBalance = string.Empty;
        _showAccountModal = false;
        await PersistLedger();
    }

    private async Task OnCurrencyChanged(ChangeEventArgs args)
    {
        _ledger.CurrencySymbol = args.Value?.ToString() ?? "€";
        await PersistLedger();
    }

    private async Task PersistLedger()
    {
        await StorageService.SaveAccountLedgerAsync(_ledger);
    }

    private string FormatAmount(decimal amount)
    {
        return $"{_ledger.CurrencySymbol} {amount.ToString("N2", Text.CurrentCulture)}";
    }

    public void Dispose()
    {
        Text.Changed -= OnTextChanged;
    }
}
