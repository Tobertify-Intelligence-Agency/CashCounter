@using System.Globalization
@using CashCount.Shared.Models
@using CashCount.Shared.Services
@using CashCount.Shared.Utilities
@inject IStorageService StorageService
@inject IPremiumService PremiumService
@inject NavigationManager NavigationManager

<div class="travel-cost">

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="save-success">@_statusMessage</div>
    }

    @* Collection Header *@
    <div class="tc-header-card">
        <div class="tc-collection-name-row">
            @if (_editingName)
            {
                <input class="tc-name-input"
                       @bind="_collection.Name"
                       @bind:event="oninput"
                       maxlength="80"
                       @onblur="StopEditingName"
                       @onkeydown="OnNameKeyDown"
                       placeholder="Trip name..."
                       id="tc-name-field" />
            }
            else
            {
                <h2 class="tc-collection-name" @onclick="StartEditingName">
                    @(string.IsNullOrWhiteSpace(_collection.Name) ? "Unnamed Trip" : _collection.Name)
                    <span class="tc-edit-hint">✏️</span>
                </h2>
            }
            <div class="tc-currency-select-wrap">
                <select class="tc-currency-select" @onchange="OnCurrencyChanged">
                    @foreach (var (symbol, label) in _currencies)
                    {
                        <option value="@symbol" selected="@(_collection.CurrencySymbol == symbol)">@label</option>
                    }
                </select>
            </div>
        </div>

        @* Summary bar *@
        <div class="tc-summary">
            <div class="tc-summary-item income">
                <span class="tc-summary-label">Income</span>
                <span class="tc-summary-amount">@_collection.CurrencySymbol @_collection.TotalIncome.ToString("N2")</span>
            </div>
            <div class="tc-summary-item expenses">
                <span class="tc-summary-label">Expenses</span>
                <span class="tc-summary-amount">@_collection.CurrencySymbol @_collection.TotalExpenses.ToString("N2")</span>
            </div>
            <div class="tc-summary-item balance @(_collection.Balance >= 0 ? "positive" : "negative")">
                <span class="tc-summary-label">Balance</span>
                <span class="tc-summary-amount">@_collection.CurrencySymbol @_collection.Balance.ToString("N2")</span>
            </div>
        </div>
    </div>

    @* Add Entry Form *@
    <div class="tc-add-card">
        <h3 class="tc-section-title">Add Entry</h3>
        <div class="tc-form">
            <div class="tc-type-toggle">
                <button class="tc-type-btn @(_newEntry.Type == EntryType.Expense ? "active expense" : "")"
                        @onclick='() => _newEntry.Type = EntryType.Expense'>
                    Expense
                </button>
                <button class="tc-type-btn @(_newEntry.Type == EntryType.Income ? "active income" : "")"
                        @onclick='() => _newEntry.Type = EntryType.Income'>
                    Income
                </button>
            </div>

            <div class="tc-form-row">
                <input class="tc-input tc-desc-input"
                       @bind="_newEntry.Description"
                       @bind:event="oninput"
                       maxlength="120"
                       placeholder="Description (e.g. Fuel, Hotel, Donation...)" />
            </div>

            <div class="tc-form-row tc-amount-row">
                <div class="tc-amount-wrap">
                    <span class="tc-currency-prefix">@_collection.CurrencySymbol</span>
                    <input class="tc-input tc-amount-input"
                           type="number"
                           min="0"
                           step="0.01"
                           inputmode="decimal"
                           @bind="_newEntryAmountStr"
                           @bind:event="oninput"
                           placeholder="0.00" />
                </div>

                <input class="tc-input tc-category-input"
                       @bind="_newEntry.Category"
                       @bind:event="oninput"
                       maxlength="60"
                       placeholder="Category (optional)" />

                <input class="tc-input tc-date-input"
                       type="date"
                       @bind="_newEntry.Date"
                       @bind:event="oninput" />
            </div>

            <button class="tc-btn-add @(_newEntry.Type == EntryType.Income ? "income" : "expense")"
                    @onclick="AddEntry"
                    disabled="@(!CanAdd)">
                + Add @_newEntry.Type.ToString()
            </button>
        </div>
    </div>

    @* Entries List *@
    @if (_collection.Entries.Count > 0)
    {
        <div class="tc-entries-card">
            <div class="tc-entries-header">
                <h3 class="tc-section-title">Entries (@_collection.Entries.Count)</h3>
                <div class="tc-filter-row">
                    <button class="tc-filter-btn @(_filter == null ? "active" : "")" @onclick='() => _filter = null'>All</button>
                    <button class="tc-filter-btn income @(_filter == EntryType.Income ? "active" : "")" @onclick='() => _filter = EntryType.Income'>Income</button>
                    <button class="tc-filter-btn expense @(_filter == EntryType.Expense ? "active" : "")" @onclick='() => _filter = EntryType.Expense'>Expenses</button>
                </div>
            </div>

            <div class="tc-entries-list">
                @foreach (var entry in FilteredEntries)
                {
                    <div class="tc-entry @(entry.Type == EntryType.Income ? "income" : "expense")">
                        <div class="tc-entry-type-bar"></div>
                        <div class="tc-entry-body">
                            <div class="tc-entry-top">
                                <span class="tc-entry-desc">@entry.Description</span>
                                <span class="tc-entry-amount @(entry.Type == EntryType.Income ? "income" : "expense")">
                                    @(entry.Type == EntryType.Income ? "+" : "-")@_collection.CurrencySymbol @entry.Amount.ToString("N2")
                                </span>
                            </div>
                            <div class="tc-entry-bottom">
                                <span class="tc-entry-meta">
                                    @if (!string.IsNullOrWhiteSpace(entry.Category))
                                    {
                                        <span class="tc-entry-category">@entry.Category</span>
                                    }
                                    <span class="tc-entry-date">@entry.Date.ToString("dd.MM.yyyy")</span>
                                </span>
                                <button class="tc-btn-delete" @onclick="() => DeleteEntry(entry.Id)" title="Delete entry">✕</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="tc-empty-state">
            <span class="tc-empty-icon">✈️</span>
            <p>No entries yet. Add your first income or expense above.</p>
        </div>
    }

    @* Save Section *@
    @if (_canSave)
    {
        <div class="save-section">
            <div class="save-input-group">
                <input type="text"
                       @bind="_saveName"
                       @bind:event="oninput"
                       maxlength="80"
                       placeholder="Trip name to save (e.g. Italy 2026)"
                       class="save-name-input" />
                <button class="btn-save"
                        @onclick="SaveCurrentTrip"
                        disabled="@(_collection.Entries.Count == 0)">
                    Save Trip
                </button>
            </div>
            @if (_showSaveSuccess)
            {
                <div class="save-success">Saved successfully!</div>
            }
        </div>
    }
    else
    {
        <div class="premium-feature-locked">
            <span class="lock-icon">🔒</span>
            <span class="lock-text">Save & Load trips</span>
            <span class="premium-badge" title="Upgrade to Premium to save trips">Premium</span>
        </div>
    }

    @if (_collection.Entries.Count > 0)
    {
        <div class="tc-action-buttons">
            <button class="btn-clear" @onclick="ClearAll">Clear All</button>
        </div>
    }
</div>

@code {
    private TravelCollection _collection = new();
    private TravelCostEntry _newEntry = new();
    private string _newEntryAmountStr = string.Empty;
    private bool _editingName;
    private EntryType? _filter;
    private bool _canSave;
    private string _saveName = string.Empty;
    private bool _showSaveSuccess;
    private string? _statusMessage;

    private static readonly List<(string Symbol, string Label)> _currencies = new()
    {
        ("€", "€ EUR"),
        ("$", "$ USD"),
        ("£", "£ GBP"),
        ("CHF", "CHF"),
        ("CA$", "CA$ CAD"),
        ("A$", "A$ AUD"),
    };

    protected override async Task OnInitializedAsync()
    {
        _canSave = await PremiumService.IsFeatureEnabledAsync(PremiumFeature.SaveTrips);

        var canLoad = await PremiumService.IsFeatureEnabledAsync(PremiumFeature.LoadTrips);
        if (canLoad)
            await TryLoadFromQueryAsync();
    }

    private async Task TryLoadFromQueryAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var loadId = QueryStringHelper.GetValue(uri.Query, "load");
        if (string.IsNullOrWhiteSpace(loadId))
            return;

        var savedTrip = await StorageService.GetTripByIdAsync(loadId);
        if (savedTrip is null)
        {
            _statusMessage = "Saved trip could not be found.";
            ClearLoadQuery(uri);
            return;
        }

        _collection = PersistedDataNormalizer.NormalizeTrip(savedTrip);
        _saveName = _collection.Name;
        _statusMessage = $"Loaded {GetDisplayTripName(_collection)}.";
        ClearLoadQuery(uri);
    }

    private void ClearLoadQuery(Uri uri)
    {
        var cleanPath = uri.GetLeftPart(UriPartial.Path);
        NavigationManager.NavigateTo(cleanPath, replace: true);
    }

    private async Task SaveCurrentTrip()
    {
        if (_collection.Entries.Count == 0)
            return;

        _collection.Name = GetTripNameForSave();
        _collection.CurrencySymbol = PersistedDataNormalizer.NormalizeName(_collection.CurrencySymbol, 8);
        _collection = PersistedDataNormalizer.NormalizeTrip(_collection);

        await StorageService.SaveTripAsync(_collection);

        _showSaveSuccess = true;
        _statusMessage = null;
        StateHasChanged();
        await Task.Delay(2000);
        _showSaveSuccess = false;
        _saveName = string.Empty;
        StateHasChanged();
    }

    private bool CanAdd =>
        !string.IsNullOrWhiteSpace(_newEntry.Description) &&
        TryParseAmount(_newEntryAmountStr, out var amount) && amount > 0;

    private IEnumerable<TravelCostEntry> FilteredEntries =>
        _filter == null
            ? _collection.Entries.OrderByDescending(e => e.Date)
            : _collection.Entries.Where(e => e.Type == _filter).OrderByDescending(e => e.Date);

    private void AddEntry()
    {
        if (!TryParseAmount(_newEntryAmountStr, out var amount) || amount <= 0)
            return;

        var entry = PersistedDataNormalizer.NormalizeEntry(new TravelCostEntry
        {
            Description = _newEntry.Description,
            Category = _newEntry.Category,
            Amount = amount,
            Type = _newEntry.Type,
            Date = _newEntry.Date
        });

        if (string.IsNullOrWhiteSpace(entry.Description))
            return;

        _collection.Entries.Add(entry);
        _statusMessage = null;

        var nextType = _newEntry.Type;
        var nextDate = _newEntry.Date;
        _newEntry = new TravelCostEntry { Type = nextType, Date = nextDate };
        _newEntryAmountStr = string.Empty;
    }

    private void DeleteEntry(string id)
    {
        _collection.Entries.RemoveAll(e => e.Id == id);
    }

    private void ClearAll()
    {
        _collection.Entries.Clear();
        _filter = null;
        _statusMessage = null;
    }

    private void OnCurrencyChanged(ChangeEventArgs e)
    {
        _collection.CurrencySymbol = PersistedDataNormalizer.NormalizeName(e.Value?.ToString(), 8);
        if (string.IsNullOrWhiteSpace(_collection.CurrencySymbol))
            _collection.CurrencySymbol = "€";
    }

    private void StartEditingName()
    {
        _editingName = true;
    }

    private void StopEditingName()
    {
        _collection.Name = PersistedDataNormalizer.NormalizeName(_collection.Name, 80);
        _editingName = false;
    }

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Escape")
            StopEditingName();
    }

    private static bool TryParseAmount(string? value, out decimal amount)
    {
        var normalized = value?.Trim().Replace(',', '.');
        return decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out amount);
    }

    private string GetTripNameForSave()
    {
        var preferredName = PersistedDataNormalizer.NormalizeName(_saveName, 80);
        if (!string.IsNullOrWhiteSpace(preferredName))
            return preferredName;

        var currentName = PersistedDataNormalizer.NormalizeName(_collection.Name, 80);
        return string.IsNullOrWhiteSpace(currentName)
            ? $"Trip {DateTime.Now:dd.MM.yyyy HH:mm}"
            : currentName;
    }

    private static string GetDisplayTripName(TravelCollection trip)
    {
        return string.IsNullOrWhiteSpace(trip.Name) ? "Unnamed Trip" : trip.Name;
    }
}
