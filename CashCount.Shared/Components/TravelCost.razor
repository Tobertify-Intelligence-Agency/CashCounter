@using System.Globalization
@using CashCount.Shared.Models
@using CashCount.Shared.Services
@using CashCount.Shared.Services.Localization
@inject IStorageService StorageService
@inject IPremiumService PremiumService
@inject NavigationManager NavigationManager
@inject IAppTextService Text
@implements IDisposable

<div class="travel-cost travel-cost-minimal">
    <section class="tc-hero-card tc-hero-card-minimal">
        <div class="tc-hero-top">
            <div>
                @if (_editingName)
                {
                    <input class="tc-name-input"
                           @bind="_collection.Name"
                           @bind:event="oninput"
                           @onblur="StopEditingName"
                           @onkeydown="OnNameKeyDown"
                           placeholder="@Text["travel.hero.placeholder"]"
                           id="tc-name-field" />
                }
                else
                {
                    <h2 class="tc-collection-name tc-collection-name-hero" @onclick="StartEditingName">
                        @(string.IsNullOrWhiteSpace(_collection.Name) ? Text["travel.hero.fallbackName"] : _collection.Name)
                    </h2>
                }
                <p class="tc-hero-hint">@Text["travel.hero.editHint"]</p>
            </div>

            <div class="tc-hero-actions">
                <select class="tc-currency-select" @onchange="OnCurrencyChanged">
                    @foreach (var (symbol, label) in _currencies)
                    {
                        <option value="@symbol" selected="@(_collection.CurrencySymbol == symbol)">@label</option>
                    }
                </select>
                <span class="count-badge">@_collection.Entries.Count @Text["travel.hero.entries"]</span>
            </div>
        </div>

        <div class="tc-summary tc-summary-minimal">
            <div class="tc-summary-item expenses">
                <span class="tc-summary-label">@Text["travel.summary.expenses"]</span>
                <span class="tc-summary-amount">@FormatAmount(_collection.TotalExpenses)</span>
            </div>
        </div>
    </section>

    <section class="tc-add-card tc-add-card-minimal">
        <div class="tc-form tc-form-compact">
            <div class="tc-form-grid-minimal">
                <label class="tc-field-block">                    
                    <input class="tc-input tc-desc-input"
                           @bind="_newEntry.Description"
                           @bind:event="oninput"
                           placeholder="@Text["travel.field.descriptionPlaceholder"]" />
                </label>

                <label class="tc-field-block">                    
                    <div class="tc-amount-wrap">
                        <span class="tc-currency-prefix">@_collection.CurrencySymbol</span>
                        <input class="tc-input tc-amount-input"
                               type="number"
                               min="0"
                               step="0.01"
                               @bind="_newEntryAmountStr"
                               @bind:event="oninput"
                               placeholder="0.00" />
                    </div>
                </label>

                <label class="tc-field-block">                    
                    <input class="tc-input tc-category-input"
                           @bind="_newEntry.Category"
                           @bind:event="oninput"
                           placeholder="@Text["travel.field.categoryPlaceholder"]" />
                </label>

                <label class="tc-field-block">                    
                    <input class="tc-input tc-date-input"
                           type="date"
                           @bind="_newEntry.Date"
                           @bind:event="oninput" />
                </label>
            </div>

            <button class="tc-btn-add expense"
                    @onclick="AddEntry"
                    disabled="@(!CanAdd)">
                @Text.Format("travel.addButton", Text["travel.type.expense"])
            </button>
        </div>
    </section>

    @if (_collection.Entries.Count > 0)
    {
        <section class="tc-entries-card tc-entries-card-minimal">
            <div class="tc-entries-header tc-entries-header-minimal">
                <div>
                    <h3 class="tc-section-title tc-section-title-plain">@Text["travel.list.title"]</h3>
                    <p>@_collection.Entries.Count @Text["travel.hero.entries"]</p>
                </div>
                <span class="count-badge">@FormatAmount(_collection.TotalExpenses)</span>
            </div>

            <div class="tc-entries-list tc-entries-list-dense">
                @foreach (var entry in _collection.Entries.OrderByDescending(e => e.Date))
                {
                    <div class="tc-entry expense tc-entry-dense">
                        <div class="tc-entry-type-bar"></div>
                        <div class="tc-entry-body">
                            <div class="tc-entry-top">
                                <div>
                                    <span class="tc-entry-desc">@entry.Description</span>
                                    <div class="tc-entry-meta tc-entry-meta-inline">
                                        @if (!string.IsNullOrWhiteSpace(entry.Category))
                                        {
                                            <span class="tc-entry-category">@entry.Category</span>
                                        }
                                        <span class="tc-entry-date">@entry.Date.ToString("d", Text.CurrentCulture)</span>
                                    </div>
                                </div>
                                <span class="tc-entry-amount expense">
                                    -@FormatAmount(entry.Amount, includeCurrencySymbol: false)
                                </span>
                            </div>
                            <div class="tc-entry-bottom tc-entry-bottom-dense">
                                <button class="tc-btn-delete" @onclick="() => DeleteEntry(entry.Id)" title="@Text["app.delete"]">✕</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <div class="tc-empty-state tc-empty-state-card">
            <span class="tc-empty-icon">✈️</span>
            <h3>@Text["travel.empty.title"]</h3>
            <p>@Text["travel.empty.body"]</p>
        </div>
    }

    @if (_canSave)
    {
        <section class="save-section tc-save-card">
            <div class="save-input-group">
                <input type="text"
                       @bind="_saveName"
                       @bind:event="oninput"
                       placeholder="@Text["travel.save.placeholder"]"
                       class="save-name-input" />
                <button class="btn-save"
                        @onclick="SaveCurrentTrip"
                        disabled="@(_collection.Entries.Count == 0)">
                    @Text["travel.save.button"]
                </button>
            </div>
            @if (_showSaveSuccess)
            {
                <div class="save-success">@Text["travel.save.success"]</div>
            }
        </section>
    }
    else
    {
        <div class="premium-feature-locked">
            <span class="lock-icon">🔒</span>
            <span class="lock-text">@Text["travel.save.locked"]</span>
            <span class="premium-badge" title="Upgrade to Premium to save trips">@Text["travel.save.lockedHint"]</span>
        </div>
    }

    @if (_collection.Entries.Count > 0)
    {
        @if (_collection.LedgerTransactionId != null)
        {
            <div class="booked-to-ledger">✓ Booked to Account Ledger</div>
        }
        else if (_showBookingPanel)
        {
            <div class="booking-panel">
                <div class="booking-panel-header">
                    <h4>Book to Account Ledger</h4>
                    <p>@_collection.CurrencySymbol @_collection.TotalExpenses.ToString("N2") will be booked as outgoing.</p>
                </div>
                @if (_ledger.Accounts.Count == 0)
                {
                    <p class="booking-no-accounts">No accounts set up yet. Add an account in the Account Ledger first.</p>
                }
                else
                {
                    <div class="booking-form">
                        <div class="saved-signature-field">
                            <label>Account</label>
                            <select class="saved-signature-input" @bind="_bookingAccountId">
                                <option value="">— Select account —</option>
                                @foreach (var acc in _ledger.Accounts)
                                {
                                    <option value="@acc.Id">@acc.Name</option>
                                }
                            </select>
                        </div>
                        <div class="saved-signature-field">
                            <label>Description</label>
                            <input class="saved-signature-input" @bind="_bookingDescription" @bind:event="oninput" placeholder="Transaction description" />
                        </div>
                    </div>
                }
                <div class="saved-signature-editor-actions">
                    <button class="btn-cancel" @onclick="() => _showBookingPanel = false">Cancel</button>
                    @if (_ledger.Accounts.Count > 0)
                    {
                        <button class="btn-load" @onclick="BookToLedgerAsync"
                                disabled="@(string.IsNullOrEmpty(_bookingAccountId))">
                            Confirm Booking
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <button class="btn-book-ledger" @onclick="OpenBookingPanel">📒 Book to Account Ledger</button>
        }

        <div class="tc-action-buttons">
            <button class="btn-clear" @onclick="ClearAll">@Text["travel.clearAll"]</button>
        </div>
    }
</div>

@code {
    private TravelCollection _collection = new();
    private TravelCostEntry _newEntry = new() { Type = EntryType.Expense };
    private string _newEntryAmountStr = string.Empty;
    private bool _editingName;
    private bool _canSave;
    private string _saveName = string.Empty;
    private bool _showSaveSuccess;

    private AccountLedger _ledger = new();
    private bool _showBookingPanel;
    private string _bookingAccountId = string.Empty;
    private string _bookingDescription = string.Empty;

    private static readonly List<(string Symbol, string Label)> _currencies = new()
    {
        ("€", "€ EUR"),
        ("$", "$ USD"),
        ("£", "£ GBP"),
        ("CHF", "CHF"),
        ("CA$", "CA$ CAD"),
        ("A$", "A$ AUD"),
    };

    protected override async Task OnInitializedAsync()
    {
        Text.Changed += OnTextChanged;
        _canSave = await PremiumService.IsFeatureEnabledAsync(PremiumFeature.SaveCounts);
        _ledger = await StorageService.GetAccountLedgerAsync();

        var canLoad = await PremiumService.IsFeatureEnabledAsync(PremiumFeature.LoadCounts);
        if (canLoad)
        {
            var uri = new Uri(NavigationManager.Uri);
            var loadId = GetQueryParameter(uri.Query, "load");
            if (!string.IsNullOrEmpty(loadId))
            {
                var savedTrip = await StorageService.GetTripByIdAsync(loadId);
                if (savedTrip != null)
                    _collection = savedTrip;
            }
        }
    }

    private void OnTextChanged() => InvokeAsync(StateHasChanged);

    private static string? GetQueryParameter(string query, string key)
    {
        if (string.IsNullOrEmpty(query)) return null;
        var pairs = query.TrimStart('?').Split('&');
        foreach (var pair in pairs)
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && parts[0].Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(parts[1]);
        }
        return null;
    }

    private async Task SaveCurrentTrip()
    {
        if (_collection.Entries.Count == 0) return;

        if (!string.IsNullOrWhiteSpace(_saveName))
            _collection.Name = _saveName;
        else if (string.IsNullOrWhiteSpace(_collection.Name))
            _collection.Name = $"Trip {DateTime.Now.ToString("g", Text.CurrentCulture)}";

        await StorageService.SaveTripAsync(_collection);

        _showSaveSuccess = true;
        StateHasChanged();
        await Task.Delay(2000);
        _showSaveSuccess = false;
        _saveName = string.Empty;
        StateHasChanged();
    }

    private bool CanAdd =>
        !string.IsNullOrWhiteSpace(_newEntry.Description) &&
        decimal.TryParse(_newEntryAmountStr, NumberStyles.Any, CultureInfo.InvariantCulture, out var v) && v > 0;

    private void AddEntry()
    {
        if (!decimal.TryParse(_newEntryAmountStr, NumberStyles.Any, CultureInfo.InvariantCulture, out var amount) || amount <= 0)
            return;

        _newEntry.Type = EntryType.Expense;
        _newEntry.Amount = amount;
        _collection.Entries.Add(_newEntry);

        var nextDate = _newEntry.Date;
        _newEntry = new TravelCostEntry { Type = EntryType.Expense, Date = nextDate };
        _newEntryAmountStr = string.Empty;
    }

    private void DeleteEntry(string id)
    {
        _collection.Entries.RemoveAll(e => e.Id == id);
    }

    private void ClearAll()
    {
        _collection.Entries.Clear();
    }

    private void OnCurrencyChanged(ChangeEventArgs e)
    {
        _collection.CurrencySymbol = e.Value?.ToString() ?? "€";
    }

    private void StartEditingName() => _editingName = true;
    private void StopEditingName() => _editingName = false;

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Escape")
            StopEditingName();
    }

    private string FormatAmount(decimal amount, bool includeCurrencySymbol = true)
    {
        var number = Math.Abs(amount).ToString("N2", Text.CurrentCulture);
        return includeCurrencySymbol ? $"{_collection.CurrencySymbol} {number}" : number;
    }

    private void OpenBookingPanel()
    {
        _bookingAccountId = string.Empty;
        _bookingDescription = string.IsNullOrWhiteSpace(_collection.Name) ? "Travel expenses" : _collection.Name;
        _showBookingPanel = true;
    }

    private async Task BookToLedgerAsync()
    {
        if (string.IsNullOrEmpty(_bookingAccountId)) return;

        var transaction = new AccountTransaction
        {
            AccountId = _bookingAccountId,
            Description = string.IsNullOrWhiteSpace(_bookingDescription) ? _collection.Name : _bookingDescription.Trim(),
            Amount = _collection.TotalExpenses,
            Direction = CashFlowDirection.Outgoing,
            Date = DateTime.Today,
            Category = "Travel"
        };

        _ledger.Transactions.Add(transaction);
        await StorageService.SaveAccountLedgerAsync(_ledger);

        _collection.LedgerTransactionId = transaction.Id;
        await StorageService.SaveTripAsync(_collection);

        _showBookingPanel = false;
    }

    public void Dispose()
    {
        Text.Changed -= OnTextChanged;
    }
}
